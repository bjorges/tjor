#!/usr/bin/env bash
# tjor — run AI coding agents inside a portable, fail-closed container cage.
#
# Every entry point gets configuration through python/tjor_cfg.py (the ONE
# merge path, charter L19) and policy verdicts through python/tjor_policy.py
# (the ONE matcher, charter L4). This script orchestrates; it never decides.
set -euo pipefail

# ---------------------------------------------------------------- preflight
if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
    echo "tjor: bash >= 4.4 required (you have ${BASH_VERSION})." >&2
    echo "      macOS: brew install bash   (then run via that bash or fix PATH)" >&2
    exit 1
fi

TJOR_ROOT="$(python3 - "${BASH_SOURCE[0]}" <<'PY' 2>/dev/null || true
import os, sys
print(os.path.dirname(os.path.dirname(os.path.realpath(sys.argv[1]))))
PY
)"

die() { echo "tjor: ERROR: $*" >&2; exit 1; }
warn() { echo "tjor: WARNING: $*" >&2; }
loud() { echo -e "\033[1;31mtjor: $*\033[0m" >&2; }

preflight() {
    local missing=()
    command -v python3 >/dev/null || missing+=("python3 (>=3.11) — brew install python / apt install python3")
    if command -v python3 >/dev/null; then
        python3 -c 'import tomllib' 2>/dev/null || missing+=("python3 >= 3.11 with tomllib — current $(python3 --version)")
    fi
    command -v docker >/dev/null || missing+=("docker — https://docs.docker.com/engine/install/ or colima")
    command -v git >/dev/null || missing+=("git")
    if docker compose version >/dev/null 2>&1; then COMPOSE=(docker compose)
    elif command -v docker-compose >/dev/null 2>&1; then COMPOSE=(docker-compose)
    else missing+=("docker compose v2 (plugin or docker-compose binary) — brew install docker-compose"); fi
    command -v shasum >/dev/null || command -v sha256sum >/dev/null || missing+=("shasum or sha256sum")
    command -v openssl >/dev/null || missing+=("openssl — required to generate the constrained (pathlen:0) session CA")
    if ((${#missing[@]})); then
        echo "tjor: missing host dependencies:" >&2
        printf '  - %s\n' "${missing[@]}" >&2
        exit 1
    fi
    [[ -n "${TJOR_ROOT}" && -f "${TJOR_ROOT}/compose.yaml" ]] || die "cannot locate tjor installation root"
    docker info >/dev/null 2>&1 || die "docker daemon not reachable — is docker/colima running?"
}

sha256() {
    if command -v sha256sum >/dev/null; then sha256sum | cut -d' ' -f1
    else shasum -a 256 | cut -d' ' -f1; fi
}

cfg() { python3 "${TJOR_ROOT}/python/tjor_cfg.py" get "$@"; }

policy_file() {
    if [[ -n "${TJOR_POLICY_OVERRIDE:-}" ]]; then echo "${TJOR_POLICY_OVERRIDE}"
    elif [[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/tjor/policy.toml" ]]; then
        echo "${XDG_CONFIG_HOME:-$HOME/.config}/tjor/policy.toml"
    else echo "${TJOR_ROOT}/config/policy.toml"; fi
}

# ------------------------------------------------------------------- images
build_proxy() {
    docker build -q -f "${TJOR_ROOT}/images/proxy/Dockerfile" \
        --build-arg BASE_IMAGE="$(cfg images.mitmproxy)" \
        -t tjor-proxy:local "${TJOR_ROOT}" >/dev/null
}

build_agent() { # $1 = harness list (comma separated)
    local harness="$1"
    echo "tjor: building agent image (${harness}) — first build downloads pinned tools" >&2
    # No AGENT_UID build-arg: the image is uid-agnostic (default uid baked;
    # the entrypoint aligns to TJOR_AGENT_UID at start), so a local build is
    # portable and matches the published image.
    docker build -f "${TJOR_ROOT}/images/agent/Dockerfile" \
        --build-arg BASE_IMAGE="$(cfg images.debian)" \
        --build-arg HARNESS="${harness}" \
        --build-arg OPENCODE_VERSION="$(cfg versions.opencode)" \
        --build-arg OPENCODE_SHA256_ARM64="$(cfg versions.sha256.opencode_linux_arm64)" \
        --build-arg OPENCODE_SHA256_X64="$(cfg versions.sha256.opencode_linux_x64)" \
        --build-arg CLAUDE_CODE_VERSION="$(cfg versions.claude_code)" \
        --build-arg COPILOT_VERSION="$(cfg versions.copilot)" \
        --build-arg GH_VERSION="$(cfg versions.gh)" \
        --build-arg GH_SHA256_ARM64="$(cfg versions.sha256.gh_linux_arm64)" \
        --build-arg GH_SHA256_AMD64="$(cfg versions.sha256.gh_linux_amd64)" \
        -t "tjor-agent-${harness//,/-}:local" "${TJOR_ROOT}"
}

build_conformance() {
    docker build -q -f "${TJOR_ROOT}/images/conformance/Dockerfile" \
        --build-arg BASE_IMAGE="$(cfg images.python)" \
        -t tjor-conformance:local "${TJOR_ROOT}" >/dev/null
}

# Pick the agent image: a prebuilt published image for this tjor version when
# available (fast first run), else a local build. A git checkout (dev) always
# builds locally — its code may differ from any published image. Images are
# uid-agnostic, so a published image serves any host user.
resolve_agent_image() { # $1 = harness ; sets TJOR_AGENT_IMAGE
    local harness="$1"
    export TJOR_AGENT_IMAGE="tjor-agent-${harness}:local"
    if [[ ! -d "${TJOR_ROOT}/.git" ]] && [[ "$(cfg images.publish --default true)" == "true" ]]; then
        local ver reg ref
        ver="$(tr -d ' \n' < "${TJOR_ROOT}/VERSION" 2>/dev/null || true)"
        reg="$(cfg images.registry --default ghcr.io/bjorges)"
        if [[ -n "${ver}" ]]; then
            ref="${reg}/tjor-agent-${harness}:${ver}"
            if docker image inspect "${ref}" >/dev/null 2>&1 || docker pull "${ref}" >/dev/null 2>&1; then
                export TJOR_AGENT_IMAGE="${ref}"
                echo "tjor: using prebuilt image ${ref}" >&2
                return 0
            fi
            echo "tjor: no prebuilt image for ${ver} reachable — building locally" >&2
        fi
    fi
    docker image inspect "${TJOR_AGENT_IMAGE}" >/dev/null 2>&1 || build_agent "${harness}"
}

# ----------------------------------------------------------------- topology
compose() { "${COMPOSE[@]}" -f "${TJOR_ROOT}/compose.yaml" "$@"; }

is_connected() { # ctr net
    docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}' "$1" | grep -qw "$2"
}

wait_internal_ip() { # svc net -> echoes a validated IP, or fails
    local ctr ip
    for _ in $(seq 1 30); do
        ctr="$(compose ps -q "$1" 2>/dev/null || true)"
        if [[ -n "${ctr}" && "$(docker inspect -f '{{.State.Running}}' "${ctr}" 2>/dev/null)" == "true" ]]; then
            ip="$(docker inspect -f "{{(index .NetworkSettings.Networks \"$2\").IPAddress}}" "${ctr}" 2>/dev/null || true)"
            if [[ "${ip}" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
                echo "${ip}"
                return 0
            fi
        fi
        sleep 1
    done
    return 1
}

ensure_topology() { # expects TJOR_PROJECT, TJOR_SESSION_DIR exported
    local pfile session_policy corefile
    pfile="$(policy_file)"
    session_policy="${TJOR_SESSION_DIR}/policy.toml"
    corefile="${TJOR_SESSION_DIR}/Corefile"
    cp "${pfile}" "${session_policy}"

    if ! python3 "${TJOR_ROOT}/python/tjor_policy.py" validate --policy "${session_policy}" >/dev/null 2>&1; then
        loud "EGRESS POLICY INVALID (${pfile}) — failing closed: ALL egress will be denied."
        python3 "${TJOR_ROOT}/python/tjor_policy.py" validate --policy "${session_policy}" || true
    fi
    python3 "${TJOR_ROOT}/python/gen_corefile.py" --policy "${session_policy}" --out "${corefile}"

    # Identity joins the hash so an identity change (e.g. a new --task)
    # recreates the proxy with the new registration.
    TJOR_CONFIG_HASH="$( { cat "${session_policy}" "${corefile}" "${TJOR_ROOT}/compose.yaml" \
            "${TJOR_BROKER_CONFIG_MOUNT:-/dev/null}"; \
        printf '%s|%s|%s|%s|%s|%s|%s|%s' "${TJOR_SESSION_ID:-}" "${TJOR_TASK_ID:-}" "${TJOR_HARNESS:-}" \
            "${TJOR_REPO:-}" "${TJOR_WORKTREE:-}" "${TJOR_PARENT_SESSION:-}" "${TJOR_INJECT_HOSTS:-}" \
            "${TJOR_BROKER_HOSTS:-}"; } \
        | sha256 | cut -c1-16)"
    export TJOR_CONFIG_HASH

    build_proxy
    ensure_session_ca
    verify_bind_source "${TJOR_SESSION_DIR}"
    [[ -n "${TJOR_WORKSPACE:-}" && -d "${TJOR_WORKSPACE:-}" ]] && verify_bind_source "${TJOR_WORKSPACE}"

    # The agent network: internal-only, launcher-managed (compose sees it as
    # external so that sidecar creation happens on the egress network first).
    local internal="${TJOR_PROJECT}_internal"
    docker network inspect "${internal}" >/dev/null 2>&1 \
        || docker network create --internal --label "tjor.session=${TJOR_SESSION}" "${internal}" >/dev/null

    # Recreate sidecars on config drift (charter L12): compare the stamp on
    # the running containers with the hash of the config we just generated.
    local force=() ctr stamp
    for svc in proxy dns; do
        ctr="$(compose ps -q "${svc}" 2>/dev/null || true)"
        if [[ -n "${ctr}" ]]; then
            stamp="$(docker inspect -f '{{index .Config.Labels "tjor.confighash"}}' "${ctr}" 2>/dev/null || true)"
            [[ "${stamp}" != "${TJOR_CONFIG_HASH}" ]] && force=(--force-recreate)
        fi
    done
    compose up -d "${force[@]}" proxy dns

    # Dual-homed sidecars: created on the egress network by compose, then
    # connected to the internal network SECOND (charter L28). Retry: the
    # network sandbox may lag container start by a moment.
    for svc in proxy dns; do
        ctr="$(compose ps -q "${svc}")"
        local attempt connected=""
        for attempt in $(seq 1 10); do
            if is_connected "${ctr}" "${internal}" \
               || docker network connect "${internal}" "${ctr}" 2>/dev/null; then
                connected=1; break
            fi
            sleep 1
            ctr="$(compose ps -q "${svc}")"
        done
        [[ -n "${connected}" ]] || die "could not connect ${svc} to ${internal} after ${attempt} attempts"
    done

    # Core guarantee verification: the agent network MUST be internal-only.
    if [[ "$(docker network inspect -f '{{.Internal}}' "${internal}")" != "true" ]]; then
        loud "CORE GUARANTEE FAILED: network ${internal} is not internal-only. Tearing down and aborting."
        compose down --remove-orphans >/dev/null 2>&1 || true
        exit 1
    fi

    # Hand the session CA *certificate* (never the key) to the agent. The
    # launcher normally pre-generated it (constrained, L25); if openssl was
    # missing, wait for the proxy to self-generate into the shared confdir.
    local proxy_ctr ok=""
    proxy_ctr="$(compose ps -q proxy)"
    for _ in $(seq 1 30); do
        if [[ -s "${TJOR_SESSION_DIR}/proxy-ca/mitmproxy-ca-cert.pem" ]]; then ok=1; break; fi
        sleep 0.5
    done
    [[ -n "${ok}" ]] || die "no session CA appeared — check: docker logs ${proxy_ctr}"
    cp "${TJOR_SESSION_DIR}/proxy-ca/mitmproxy-ca-cert.pem" "${TJOR_SESSION_DIR}/ca.pem"

    # Readiness: wait until mitmdump actually LISTENS. (The CA used to be
    # docker-cp'd out of the proxy, which accidentally doubled as a boot
    # gate; the host-generated CA removed that, so the gate must be real.)
    local ready=""
    for _ in $(seq 1 60); do
        if docker exec "${proxy_ctr}" python3 -c \
            "import socket; socket.create_connection(('127.0.0.1', ${TJOR_PROXY_PORT}), 2).close()" \
            >/dev/null 2>&1; then ready=1; break; fi
        sleep 1
    done
    if [[ -z "${ready}" ]]; then
        echo "tjor: proxy diagnostics (state, restarts, last logs):" >&2
        docker inspect -f 'state={{.State.Status}} restarts={{.RestartCount}} exitcode={{.State.ExitCode}}' "${proxy_ctr}" >&2 || true
        docker logs --tail 40 "${proxy_ctr}" >&2 || true
        die "proxy never started listening on :${TJOR_PROXY_PORT}"
    fi

    # Discover sidecar internal IPs. Guard against not-yet-running or
    # crash-looping containers: docker 29 renders an empty IP as the literal
    # string "invalid IP", so validate the shape and retry until stable.
    TJOR_PROXY_IP="$(wait_internal_ip proxy "${internal}")" \
        || die "proxy has no internal IP (crash loop?) — check: docker logs ${proxy_ctr}"
    TJOR_DNS_IP="$(wait_internal_ip dns "${internal}")" \
        || die "dns has no internal IP (crash loop?) — check: docker logs $(compose ps -q dns)"
    export TJOR_PROXY_IP TJOR_DNS_IP

    report_tiers
}

report_tiers() {
    echo "tjor: core guarantees active: internal-only network, fail-closed egress proxy, zone-scoped DNS, non-root agent" >&2
    if docker info --format '{{join .SecurityOptions ","}}' 2>/dev/null | grep -q apparmor; then
        echo "tjor: hardening add-on available: AppArmor (profiles ship in a later tjor release)" >&2
    else
        warn "hardening add-on INACTIVE: AppArmor not supported by this container runtime (guarantee tier: core only)"
    fi
}

# ----------------------------------------------------------------- sessions
# Write broker.json created 0o600 from the start (os.open with the mode) so
# the secret never exists briefly world-readable.
write_broker_json() { # $1 out, $2 source, then source args
    python3 - "$@" <<'PY'
import json, os, sys
out, source = sys.argv[1], sys.argv[2]
if source == "pat":
    cfg = {"source": "pat", "token": sys.argv[3]}
else:
    app, inst, keypath, repos = sys.argv[3], sys.argv[4], sys.argv[5], sys.argv[6]
    cfg = {"source": "github-app", "app_id": app, "installation_id": inst,
           "private_key": open(keypath).read(), "repositories": json.loads(repos)}
fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as fh:
    fh.write(json.dumps(cfg))
PY
}

prepare_broker() {
    # Credential broker (D2): assemble the broker config into the SESSION DIR
    # (mounted only into the proxy sidecar, egress side), resolving secrets
    # host-side so nothing sensitive is ever passed to the agent. Sets
    # TJOR_BROKER_* for compose. Fail-closed: any problem disables injection
    # loudly rather than silently downgrading to a long-lived token.
    export TJOR_BROKER_CONFIG_MOUNT="" TJOR_BROKER_HOSTS="" TJOR_BROKER_ENABLED="" TJOR_BROKER_DIR=""
    local source; source="$(cfg broker.source --default '')"
    [[ -n "${source}" ]] || return 0
    local dir="${TJOR_SESSION_DIR}/broker"
    mkdir -p "${dir}"; chmod 700 "${dir}"
    local hosts; hosts="$(cfg broker.hosts --default '[]' \
        | python3 -c 'import json,sys; print(",".join(json.load(sys.stdin)))')"
    # broker.json is created 0o600 atomically by write_broker_json (os.open
    # with the mode), so the secret is never briefly world-readable between
    # write and a separate chmod (the dir is 700 too).
    case "${source}" in
        pat)
            local envname token; envname="$(cfg broker.pat_env --default TJOR_GITHUB_PAT)"
            token="${!envname:-}"
            [[ -n "${token}" ]] || { warn "broker source=pat but \$${envname} is empty — broker disabled"; return 0; }
            write_broker_json "${dir}/broker.json" pat "${token}" ;;
        github-app)
            local app inst keypath; app="$(cfg broker.app_id)"; inst="$(cfg broker.installation_id)"
            keypath="$(cfg broker.private_key_path)"; keypath="${keypath/#\~/$HOME}"
            [[ -n "${app}" && -n "${inst}" && -s "${keypath}" ]] \
                || { warn "broker source=github-app needs app_id, installation_id, and a readable private_key_path — broker disabled"; return 0; }
            local repos; repos="$(cfg broker.repositories --default '[]')"
            write_broker_json "${dir}/broker.json" github-app "${app}" "${inst}" "${keypath}" "${repos}" ;;
        *) warn "unknown broker.source '${source}' — broker disabled"; return 0 ;;
    esac
    export TJOR_BROKER_CONFIG_MOUNT="${dir}/broker.json"
    export TJOR_BROKER_DIR="${dir}"
    export TJOR_BROKER_HOSTS="${hosts}"
    export TJOR_BROKER_ENABLED=1
    echo "tjor: credential broker active (source=${source}) — the agent holds only a placeholder" >&2
}

export_static_env() {
    export TJOR_PROXY_IMAGE="tjor-proxy:local"
    TJOR_COREDNS_IMAGE="$(cfg images.coredns)"
    TJOR_PROXY_PORT="$(cfg proxy.port --default 8080)"
    TJOR_IP_GUARD="$([ "$(cfg proxy.ip_guard --default true)" = "false" ] && echo off || echo on)"
    TJOR_AGENT_MEM="$(cfg limits.agent_mem --default 4g)"
    TJOR_PROXY_MEM="$(cfg limits.proxy_mem --default 1g)"
    TJOR_DNS_MEM="$(cfg limits.dns_mem --default 256m)"
    TJOR_CONFORMANCE_MEM="$(cfg limits.conformance_mem --default 512m)"
    export TJOR_COREDNS_IMAGE TJOR_PROXY_PORT TJOR_IP_GUARD
    export TJOR_AGENT_MEM TJOR_PROXY_MEM TJOR_DNS_MEM TJOR_CONFORMANCE_MEM
}

ensure_session_ca() {
    # Pre-generate the session MITM CA with the charter L25 constraints:
    # pathlen:0 (key disclosure yields leaf-only interception, never a
    # delegable intermediate) and EKU serverAuth. mitmproxy reads it from
    # its confdir; only the certificate is ever handed to the agent.
    local cadir="${TJOR_SESSION_DIR}/proxy-ca"
    mkdir -p "${cadir}"
    chmod 700 "${cadir}"
    [[ -s "${cadir}/mitmproxy-ca.pem" ]] && return 0
    if command -v openssl >/dev/null 2>&1; then
        openssl req -x509 -newkey rsa:2048 -nodes -days 365 \
            -keyout "${cadir}/ca-key.pem" -out "${cadir}/mitmproxy-ca-cert.pem" \
            -subj "/CN=tjor session CA/O=tjor" \
            -addext "basicConstraints=critical,CA:TRUE,pathlen:0" \
            -addext "keyUsage=critical,keyCertSign,cRLSign" \
            -addext "extendedKeyUsage=serverAuth" >/dev/null 2>&1
        cat "${cadir}/ca-key.pem" "${cadir}/mitmproxy-ca-cert.pem" > "${cadir}/mitmproxy-ca.pem"
        chmod 600 "${cadir}/ca-key.pem" "${cadir}/mitmproxy-ca.pem"
        chmod 644 "${cadir}/mitmproxy-ca-cert.pem"
        if ! openssl x509 -in "${cadir}/mitmproxy-ca-cert.pem" -text -noout | grep -q "pathlen:0"; then
            warn "generated session CA lacks pathlen:0 — check your openssl version"
        fi
    else
        warn "openssl not found — the proxy will self-generate an UNCONSTRAINED CA (no pathlen:0). Install openssl for the constrained one."
    fi
}

verify_bind_source() {
    # VM-based runtimes (Colima, Docker Desktop) share only configured host
    # paths; a bind source outside them silently appears EMPTY inside the
    # VM. Compare: if the dir has content on the host, a container must see
    # content too.
    local dir="$1"
    [[ -n "$(ls -A "${dir}" 2>/dev/null)" ]] || return 0   # empty on host: nothing to compare
    if ! docker run --rm -v "${dir}:/tjor-check:ro" --entrypoint /bin/sh "${TJOR_PROXY_IMAGE}" \
            -c '[ -n "$(ls -A /tjor-check)" ]' >/dev/null 2>&1; then
        die "${dir} is not shared with the Docker VM — bind mounts of it appear EMPTY in containers. Move it under \$HOME or add it to the VM's shared paths (colima/Docker Desktop file sharing)."
    fi
}

session_setup() { # $1 = harness, $2 = task id (optional), $3 = session name (optional)
    local ws root sid in_repo=""
    if ws="$(git rev-parse --show-toplevel 2>/dev/null)"; then in_repo=1; else
        ws="$(pwd)"
        warn "not inside a git repository — using ${ws} as the workspace"
    fi
    # shellcheck disable=SC2088  # literal ~ is expanded on the next line
    root="$(cfg session.root --default "~/.tjor/sessions")"; root="${root/#\~/$HOME}"
    sid="$(basename "${ws}" | tr -cd 'a-zA-Z0-9_.-' | tr '[:upper:]' '[:lower:]')-$(printf %s "${ws}" | sha256 | cut -c1-8)"
    # Named sessions (D3): the name folds into the id, so every downstream
    # per-session resource (topology, state root, identity, CA) separates
    # automatically (charter L29).
    if [[ -n "${3:-}" ]]; then
        [[ "$3" =~ ^[A-Za-z0-9._-]{1,32}$ ]] || die "--session must match [A-Za-z0-9._-]{1,32}"
        sid="${sid}-$(tr '[:upper:]' '[:lower:]' <<<"$3")"
    fi
    TJOR_LAUNCHED_AT="$(date +%s)"
    export TJOR_LAUNCHED_AT

    # Session identity (D1): frozen at launch, delivered to the agent (env)
    # and to the proxy (x-agent-* verification / opt-in injection).
    export TJOR_SESSION_ID="${sid}"
    export TJOR_HARNESS="$1"
    TJOR_REPO="$(basename "${ws}" | tr -cd 'a-zA-Z0-9_.-')"
    export TJOR_REPO
    TJOR_WORKTREE=""
    if [[ -n "${in_repo}" ]]; then
        local gitdir commondir
        gitdir="$(git rev-parse --absolute-git-dir 2>/dev/null || true)"
        commondir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
        [[ -n "${gitdir}" && -n "${commondir}" && "${gitdir}" != "${commondir}" ]] && TJOR_WORKTREE="${ws}"
    fi
    export TJOR_WORKTREE
    if [[ -n "${2:-}" ]]; then
        [[ "$2" =~ ^[A-Za-z0-9._-]{1,64}$ ]] || die "--task must match [A-Za-z0-9._-]{1,64}"
        export TJOR_TASK_ID="$2"
    else
        export TJOR_TASK_ID=""
    fi
    export TJOR_PARENT_SESSION="${TJOR_PARENT_SESSION:-}"
    TJOR_INJECT_HOSTS="$(cfg identity.inject_hosts --default '[]' \
        | python3 -c 'import json,sys; print(",".join(json.load(sys.stdin)))')"
    export TJOR_INJECT_HOSTS

    export TJOR_SESSION="${sid}"
    export TJOR_PROJECT="tjor-${sid}"
    export TJOR_SESSION_DIR="${root}/${sid}"
    export TJOR_WORKSPACE="${ws}"
    TJOR_LAUNCH_DIR="$(pwd)"
    export TJOR_LAUNCH_DIR
    export TJOR_AGENT_IMAGE="tjor-agent-$1:local"
    TJOR_AGENT_UID="$(id -u)"; export TJOR_AGENT_UID   # runtime uid alignment (uid-agnostic image)
    export_static_env
    mkdir -p "${TJOR_SESSION_DIR}/home"
    prepare_broker
}

cmd_run() {
    local harness="opencode" task="" name="" detach=""
    local -a extra_dirs=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --harness) harness="$2"; shift 2 ;;
            --task) task="$2"; shift 2 ;;
            --session) name="$2"; shift 2 ;;
            --dir) extra_dirs+=("$2"); shift 2 ;;
            --detach|-d) detach=1; shift ;;
            --) shift; break ;;
            *) break ;;
        esac
    done
    session_setup "${harness}" "${task}" "${name}"
    # Multi-repo (--dir): resolve each to an absolute path now (existence
    # check); VM-share verification + mounting happen in run_agent, after the
    # proxy image (used by the share check) is built.
    TJOR_EXTRA_DIRS=()
    local d abs
    for d in "${extra_dirs[@]}"; do
        [[ -d "${d}" ]] || die "--dir path does not exist or is not a directory: ${d}"
        abs="$(cd "${d}" && pwd -P)" || die "--dir path unreadable: ${d}"
        [[ "${abs}" == "${TJOR_WORKSPACE}" ]] && continue   # primary already mounted
        TJOR_EXTRA_DIRS+=("${abs}")
    done
    resolve_agent_image "${harness}"
    # Collision guard: a session id already backing a running agent must not
    # be launched again — a second unnamed `tjor run` in the same workspace
    # would otherwise share this one's CA/network/identity, and a later
    # `tjor down`/`gc` would tear down both at once. Refuse with a clear path
    # forward (attach, or name the second session).
    if docker ps -q --filter "label=tjor.role=agent" --filter "label=tjor.session=${TJOR_SESSION}" --filter status=running | grep -q .; then
        die "session ${TJOR_SESSION} is already running — reattach with 'tjor attach ${TJOR_SESSION}', or start a separate one with --session <name>"
    fi
    ensure_topology
    echo "tjor: session ${TJOR_SESSION} — workspace ${TJOR_WORKSPACE}" >&2
    local -a agent_cmd=()
    if [[ $# -gt 0 ]]; then agent_cmd=("$@")
    else case "${harness}" in claude) agent_cmd=(claude) ;; copilot) agent_cmd=(copilot) ;; *) agent_cmd=(opencode) ;; esac; fi
    run_agent "${detach}" "${agent_cmd[@]}"
}

# Launch the agent DETACHED and persistent, then (unless --detach) attach to
# it. Detached + no --rm is what makes `tjor attach` meaningful: the
# container outlives the launching terminal, so a dropped connection leaves a
# session to reattach to (compose run --rm would delete it the moment the
# client went away). Cleanup is `tjor down` / `tjor gc`, not --rm.
run_agent() { # $1 = detach flag, $2.. = command
    local detach="$1"; shift
    local ctr running code
    # Multi-repo: verify (proxy image now exists) and mount each extra dir at
    # its host path, writable.
    local -a mounts=() dir
    for dir in "${TJOR_EXTRA_DIRS[@]:-}"; do
        [[ -n "${dir}" ]] || continue
        verify_bind_source "${dir}"
        mounts+=(--volume "${dir}:${dir}")
        echo "tjor: + repo mount ${dir}" >&2
    done
    ctr="$(compose run -d "${mounts[@]}" agent "$@")" || die "failed to start the agent container"
    if [[ -n "${detach}" ]]; then
        echo "tjor: session ${TJOR_SESSION} started detached — attach with: tjor attach ${TJOR_SESSION}" >&2
        return 0
    fi
    running="$(docker inspect -f '{{.State.Running}}' "${ctr}" 2>/dev/null || echo false)"
    if [[ "${running}" == "true" ]]; then
        echo "tjor: attached — detach without stopping the agent: ctrl-p ctrl-q" >&2
        docker attach --sig-proxy=false "${ctr}" || true
    fi
    code="$(docker inspect -f '{{.State.ExitCode}}' "${ctr}" 2>/dev/null || echo 0)"
    exit "${code:-0}"
}

# Gracefully stop a session's proxy so mitmdump runs its done() hook (which
# revokes the brokered credential). docker rm -f sends SIGKILL with no grace,
# so the proxy MUST be stopped with SIGTERM first, before anything force-
# removes it — otherwise revoke-on-teardown never fires (external review).
graceful_proxy_stop() { # $1 = session id
    local pc
    pc="$(docker ps -q --filter "label=tjor.session=$1" --filter "label=tjor.role=proxy" | head -1)"
    [[ -n "${pc}" ]] || return 0
    docker stop -t 12 "${pc}" >/dev/null 2>&1 || true
}

cmd_down() {
    local name=""
    [[ "${1:-}" == "--session" ]] && name="$2"
    session_setup "opencode" "" "${name}"
    graceful_proxy_stop "${TJOR_SESSION}"
    # Persistent agent (compose run -d) containers aren't reliably caught by
    # `down --remove-orphans`; remove this session's by label explicitly.
    docker ps -aq --filter "label=tjor.session=${TJOR_SESSION}" | xargs -r docker rm -f >/dev/null 2>&1 || true
    compose down --volumes --remove-orphans
    docker network rm "${TJOR_PROJECT}_internal" >/dev/null 2>&1 || true
    echo "tjor: session topology ${TJOR_PROJECT} removed (state in ${TJOR_SESSION_DIR} preserved)" >&2
}

cmd_status() {
    local name=""
    [[ "${1:-}" == "--session" ]] && name="$2"
    session_setup "opencode" "" "${name}"
    compose ps
}

# ---------------------------------------------------------------- lifecycle

humanize_age() { # seconds -> compact age
    local s=$1
    if ((s < 3600)); then echo "$((s / 60))m"
    elif ((s < 86400)); then echo "$((s / 3600))h"
    else echo "$((s / 86400))d"; fi
}

iso_to_epoch() {
    python3 -c '
import sys, datetime
s = sys.argv[1].split(".")[0].removesuffix("Z")
try:
    print(int(datetime.datetime.fromisoformat(s + "+00:00").timestamp()))
except Exception:
    print(0)' "$1" 2>/dev/null || echo 0
}

cmd_ls() {
    # Discovery is label-driven; container names are never parsed.
    local now
    now="$(date +%s)"
    declare -A total agents_running any_running ws task launched
    # Field-separate on US (\x1f), not '|': a workspace path can contain a
    # literal pipe, which would misparse and mislabel a running session.
    while IFS=$'\x1f' read -r state sid wsp tsk lat role; do
        [[ -n "${sid}" ]] || continue
        total[${sid}]=$((${total[${sid}]:-0} + 1))
        [[ "${state}" == "running" && "${role}" == "agent" ]] && agents_running[${sid}]=$((${agents_running[${sid}]:-0} + 1))
        [[ "${state}" == "running" ]] && any_running[${sid}]=1
        [[ -n "${wsp}" ]] && ws[${sid}]="${wsp}"
        [[ -n "${tsk}" ]] && task[${sid}]="${tsk}"
        [[ -n "${lat}" ]] && launched[${sid}]="${lat}"
    done < <(docker ps -a --filter label=tjor.session \
        --format $'{{.State}}\x1f{{.Label "tjor.session"}}\x1f{{.Label "tjor.workspace"}}\x1f{{.Label "tjor.task"}}\x1f{{.Label "tjor.launched-at"}}\x1f{{.Label "tjor.role"}}')
    if ((${#total[@]} == 0)); then
        echo "tjor: no sessions" >&2
        return 0
    fi
    printf '%-40s %-9s %-7s %-6s %-40s %s\n' SESSION STATE AGENTS AGE WORKSPACE TASK
    local sid state age
    {
        for sid in "${!total[@]}"; do
            if ((${agents_running[${sid}]:-0} > 0)); then state="RUNNING"
            elif [[ -n "${any_running[${sid}]:-}" ]]; then state="IDLE"
            else state="EXITED"; fi
            # Re-verify the core guarantee for anything still running: the
            # launch-time check gets a repeatable checkpoint here.
            if [[ -n "${any_running[${sid}]:-}" ]] \
               && [[ "$(docker network inspect -f '{{.Internal}}' "tjor-${sid}_internal" 2>/dev/null)" != "true" ]]; then
                state="DEGRADED"
                loud "session ${sid} is DEGRADED: its agent network is NOT internal-only — treat the boundary as broken (tjor down / gc)"
            fi
            age="-"
            [[ -n "${launched[${sid}]:-}" ]] && age="$(humanize_age $((now - launched[${sid}])))"
            printf '%-40s %-9s %-7s %-6s %-40s %s\n' "${sid}" "${state}" \
                "${agents_running[${sid}]:-0}/${total[${sid}]}" "${age}" "${ws[${sid}]:--}" "${task[${sid}]:--}"
        done
    } | sort
}

cmd_attach() {
    local want="${1:-}" chosen ctr
    local -a rows=()
    # Field-separate on US (\x1f), not '|' — a workspace path can contain a
    # literal pipe (consistent with ls/gc).
    mapfile -t rows < <(docker ps --filter label=tjor.role=agent --filter status=running \
        --format $'{{.ID}}\x1f{{.Label "tjor.session"}}\x1f{{.Label "tjor.workspace"}}\x1f{{.Label "tjor.task"}}' \
        | { if [[ -n "${want}" ]]; then awk -F$'\x1f' -v s="${want}" '$2 == s'; else cat; fi; })
    ((${#rows[@]} > 0)) || die "no running agent${want:+ for session ${want}} — see: tjor ls"
    if ((${#rows[@]} == 1)); then
        chosen="${rows[0]}"
    elif command -v fzf >/dev/null 2>&1; then
        chosen="$(printf '%s\n' "${rows[@]}" | fzf --delimiter=$'\x1f' --with-nth=2.. --prompt='tjor attach> ')" \
            || die "nothing selected"
    else
        echo "tjor: several running agents:" >&2
        local i=1 row
        for row in "${rows[@]}"; do echo "  ${i}) $(cut -d$'\x1f' -f2,3 <<<"${row}")" >&2; ((i += 1)); done
        read -rp "attach to [1-${#rows[@]}]: " i
        if ! [[ "${i}" =~ ^[0-9]+$ ]] || ((i < 1 || i > ${#rows[@]})); then die "invalid selection"; fi
        chosen="${rows[$((i - 1))]}"
    fi
    ctr="$(cut -d$'\x1f' -f1 <<<"${chosen}")"
    # Testability seam: attach's logic is candidate RESOLUTION (above); the
    # exec below is a thin, trusted docker shell-out that cannot be driven
    # deterministically without a real TTY. TJOR_ATTACH_DRY reports the
    # resolved target instead of exec'ing, so tests verify the logic.
    if [[ -n "${TJOR_ATTACH_DRY:-}" ]]; then
        echo "$(cut -d$'\x1f' -f2 <<<"${chosen}") ${ctr}"
        return 0
    fi
    echo "tjor: attaching to $(cut -d$'\x1f' -f2 <<<"${chosen}") — detach without killing it: ctrl-p ctrl-q" >&2
    # --sig-proxy=false: interaction is through the PTY and detach is the
    # escape sequence, so the attach client's own signals (a stray SIGTERM,
    # timeout, a killed parent) must NOT be forwarded to tear down the agent.
    exec docker attach --sig-proxy=false "${ctr}"
}

cmd_gc() {
    local age_hours=24 dry="" now cutoff
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --age) age_hours="$2"; shift 2 ;;
            --dry-run) dry=1; shift ;;
            *) die "usage: tjor gc [--age <hours>] [--dry-run]" ;;
        esac
    done
    now="$(date +%s)"
    cutoff=$((now - age_hours * 3600))
    # gc deletes DOCKER RESOURCES ONLY, selected by tjor labels. Session
    # state dirs (auth!) are never touched here — that is `tjor reset`,
    # explicit and tiered. Last activity = newest agent FinishedAt, falling
    # back to launch time for sidecar-only sessions.
    declare -A has_running last_activity
    local id sid state role lat t
    while IFS=$'\x1f' read -r id sid state role lat; do
        [[ -n "${sid}" ]] || continue
        [[ "${state}" == "running" && "${role}" == "agent" ]] && has_running[${sid}]=1
        t=0
        if [[ "${role}" == "agent" && "${state}" != "running" ]]; then
            t="$(iso_to_epoch "$(docker inspect -f '{{.State.FinishedAt}}' "${id}" 2>/dev/null || true)")"
        fi
        [[ "${t}" == 0 && -n "${lat}" ]] && t="${lat}"
        ((t > ${last_activity[${sid}]:-0})) && last_activity[${sid}]="${t}"
    done < <(docker ps -a --filter label=tjor.session \
        --format $'{{.ID}}\x1f{{.Label "tjor.session"}}\x1f{{.State}}\x1f{{.Label "tjor.role"}}\x1f{{.Label "tjor.launched-at"}}')

    local reaped=0
    for sid in "${!last_activity[@]}"; do
        [[ -n "${has_running[${sid}]:-}" ]] && continue
        ((${last_activity[${sid}]:-0} <= cutoff)) || continue
        if [[ -n "${dry}" ]]; then
            echo "tjor gc: would tear down session ${sid} (idle $(humanize_age $((now - last_activity[${sid}])))): containers, networks, volumes — state dir untouched"
        else
            echo "tjor gc: tearing down idle session ${sid}" >&2
            # Stop the proxy gracefully first so its done() hook revokes the
            # session's brokered credential (D2) before force-removal (which
            # would SIGKILL it and skip revocation).
            graceful_proxy_stop "${sid}"
            docker ps -aq --filter "label=tjor.session=${sid}" | xargs -r docker rm -f >/dev/null 2>&1 || true
            "${COMPOSE[@]}" -p "tjor-${sid}" down --volumes --remove-orphans >/dev/null 2>&1 || true
            docker network rm "tjor-${sid}_internal" >/dev/null 2>&1 || true
        fi
        ((reaped += 1))
    done

    # Orphaned tjor-labeled networks whose session has no containers at all.
    local net netsid
    while read -r net; do
        netsid="$(docker network inspect -f '{{index .Labels "tjor.session"}}' "${net}" 2>/dev/null || true)"
        [[ -n "${netsid}" && -z "${has_running[${netsid}]:-}" && -z "${last_activity[${netsid}]:-}" ]] || continue
        if [[ -n "${dry}" ]]; then
            echo "tjor gc: would remove orphaned network ${net}"
        else
            docker network rm "${net}" >/dev/null 2>&1 || true
        fi
        ((reaped += 1))
    done < <(docker network ls --filter label=tjor.session --format '{{.Name}}')

    ((reaped > 0)) || echo "tjor gc: nothing to reap" >&2
}

cmd_reset() {
    local name="" dry="" tier="" force_reset=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --session) name="$2"; shift 2 ;;
            --dry-run) dry=1; shift ;;
            --force) force_reset=1; shift ;;
            cache|sessions|creds|all) tier="$1"; shift ;;
            *) die "usage: tjor reset {cache|sessions|creds|all} [--session <name>] [--dry-run] [--force]" ;;
        esac
    done
    [[ -n "${tier}" ]] || die "tjor reset requires an explicit tier: cache | sessions | creds | all"
    session_setup "opencode" "" "${name}"
    # TOCTOU guard: the ancestors check and the rm are two syscalls. With the
    # persistent-container model a LIVE agent (write access to the same home
    # tree) could swap a dir for a symlink between them. Refuse to reset a
    # running session — `tjor down` first — unless --force is given (a live
    # race is then the caller's accepted risk). This removes the racer.
    if [[ -z "${dry}" && -z "${force_reset}" ]] \
       && docker ps -q --filter "label=tjor.role=agent" --filter "label=tjor.session=${TJOR_SESSION}" --filter status=running | grep -q .; then
        die "session ${TJOR_SESSION} has a running agent — 'tjor down' first, or pass --force (accepts a live-swap race)"
    fi
    local -a paths=()
    case "${tier}" in
        cache) paths=("${TJOR_SESSION_DIR}/home/.cache") ;;
        sessions) paths=(
            "${TJOR_SESSION_DIR}/home/.local/state"
            "${TJOR_SESSION_DIR}/home/.local/share/opencode/storage"
            "${TJOR_SESSION_DIR}/home/.local/share/opencode/log"
        ) ;;
        creds) paths=(
            "${TJOR_SESSION_DIR}/broker"
            "${TJOR_SESSION_DIR}/proxy-ca"
            "${TJOR_SESSION_DIR}/ca.pem"
            "${TJOR_SESSION_DIR}/home/.local/share/opencode/auth.json"
            "${TJOR_SESSION_DIR}/home/.config/gh"
        ) ;;
        all) paths=("${TJOR_SESSION_DIR}") ;;
    esac
    local p found=""
    for p in "${paths[@]}"; do
        [[ -e "${p}" || -L "${p}" ]] || continue
        # charter L26: rm removes a *leaf* symlink safely, but it FOLLOWS a
        # symlink anywhere in the path PREFIX — so an agent that swaps an
        # intermediate dir (e.g. home/.local/share/opencode) for a symlink
        # could redirect the wipe outside the session. Refuse unless every
        # ancestor of the target is a real directory under the session root.
        if ! ancestors_are_real_dirs "${TJOR_SESSION_DIR}" "${p}"; then
            loud "reset: REFUSING ${p} — a symlink in its path could redirect deletion outside the session (charter L26)"
            continue
        fi
        found=1
        if [[ -n "${dry}" ]]; then
            echo "tjor reset: would delete ${p}"
        else
            rm -rf "${p}"
            echo "tjor reset: deleted ${p}" >&2
        fi
    done
    [[ -n "${found}" ]] || echo "tjor reset: nothing to delete for tier '${tier}'" >&2
}

# Every ancestor of <target>, from <root> down to target's parent, must be a
# real directory (not a symlink, not a non-dir). The leaf itself may be a
# symlink — rm removes the link, not its target. Returns non-zero on any
# violation, including target not being under root.
ancestors_are_real_dirs() { # $1 root, $2 target
    local root="$1" target="$2" parent rel cur comp
    [[ "${target}" == "${root}/"* ]] || { [[ "${target}" == "${root}" ]] && return 0 || return 1; }
    parent="$(dirname "${target}")"
    [[ -L "${root}" ]] && return 1
    rel="${parent#"${root}"}"; rel="${rel#/}"
    cur="${root}"
    local IFS='/'
    for comp in ${rel}; do
        [[ -z "${comp}" ]] && continue
        cur="${cur}/${comp}"
        [[ -L "${cur}" ]] && return 1
        [[ -e "${cur}" && ! -d "${cur}" ]] && return 1
    done
    return 0
}

cmd_policy() {
    [[ $# -ge 1 ]] || die "usage: tjor policy <url>"
    python3 "${TJOR_ROOT}/python/tjor_policy.py" check --policy "$(policy_file)" "$1"
}

cmd_conformance() {
    export TJOR_POLICY_OVERRIDE="${TJOR_ROOT}/images/conformance/policy.toml"
    export TJOR_SESSION="conformance"
    export TJOR_SESSION_ID="conformance"
    export TJOR_HARNESS="conformance"
    export TJOR_REPO="conformance"
    export TJOR_TASK_ID="" TJOR_WORKTREE="" TJOR_PARENT_SESSION=""
    export TJOR_INJECT_HOSTS="echo-inject.tjor-test"
    TJOR_LAUNCHED_AT="$(date +%s)"
    export TJOR_LAUNCHED_AT
    export TJOR_PROJECT="tjor-conformance"
    # Session dir must live under $HOME: VM-based runtimes (Colima, Docker
    # Desktop) only share user paths, and an unshared bind source silently
    # becomes an empty directory inside the VM.
    mkdir -p "${HOME}/.tjor/tmp"
    TJOR_SESSION_DIR="$(mktemp -d "${HOME}/.tjor/tmp/conformance.XXXXXX")"
    export TJOR_SESSION_DIR
    export TJOR_WORKSPACE="${TJOR_SESSION_DIR}"
    export TJOR_LAUNCH_DIR="${TJOR_SESSION_DIR}"
    mkdir -p "${TJOR_SESSION_DIR}/home"
    export_static_env
    # Stub broker (D2): a pat source with a known token, injected toward the
    # echo-broker host only. The probe asserts the token reaches the echo
    # upstream but is ABSENT from the conformance container.
    TJOR_TEST_BROKER_TOKEN="tjor-stub-secret-$(printf %s "${TJOR_SESSION_DIR}" | sha256 | cut -c1-12)"
    export TJOR_TEST_BROKER_TOKEN
    local bdir="${TJOR_SESSION_DIR}/broker"
    mkdir -p "${bdir}"; chmod 700 "${bdir}"
    write_broker_json "${bdir}/broker.json" pat "${TJOR_TEST_BROKER_TOKEN}"
    export TJOR_BROKER_DIR="${bdir}" TJOR_BROKER_CONFIG_MOUNT="${bdir}/broker.json"
    export TJOR_BROKER_HOSTS="echo-broker.tjor-test" TJOR_BROKER_ENABLED=1
    # Clean up even when interrupted — an aborted run must not leak
    # containers, networks, or the temp session dir.
    trap 'compose down --volumes --remove-orphans >/dev/null 2>&1 || true;
          docker network rm "${TJOR_PROJECT}_internal" >/dev/null 2>&1 || true;
          rm -rf "${TJOR_SESSION_DIR}"' EXIT
    trap 'exit 130' INT TERM   # make Ctrl-C exit promptly; EXIT trap cleans up
    # The identity probes talk to an echo fixture on a container-network
    # (non-global) address; the rebind guard would rightly deny that, so it
    # is off HERE ONLY. The guard itself is covered by unit tests.
    export TJOR_IP_GUARD="off"
    build_conformance
    ensure_topology
    "${COMPOSE[@]}" -f "${TJOR_ROOT}/compose.yaml" up -d echo >/dev/null 2>&1
    local rc=0
    "${COMPOSE[@]}" -f "${TJOR_ROOT}/compose.yaml" run --rm conformance || rc=$?
    if ((rc == 0)); then echo "tjor: conformance PASSED — the boundary holds" >&2
    else loud "conformance FAILED (rc=${rc}) — the boundary does NOT hold"; fi
    return "${rc}"
}

cmd_doctor() {
    echo "tjor root:     ${TJOR_ROOT}"
    echo "policy file:   $(policy_file)"
    python3 "${TJOR_ROOT}/python/tjor_policy.py" validate --policy "$(policy_file)" || true
    report_tiers
    if [[ "${1:-}" == "--full" ]]; then cmd_conformance; fi
}

cmd_build() {
    local harness="opencode"
    [[ "${1:-}" == "--harness" ]] && harness="$2"
    build_proxy && echo "tjor: built tjor-proxy:local" >&2
    build_conformance && echo "tjor: built tjor-conformance:local" >&2
    build_agent "${harness}"
}

usage() {
    cat <<'EOF'
tjor — run AI coding agents inside a portable, fail-closed container cage

usage: tjor <command> [args]

  run [--harness opencode|claude|copilot] [--task <id>] [--session <name>] [--dir <path>]... [--detach] [cmd...]
                                                     launch a caged session (--dir: mount another repo at its host path; --detach: start without attaching)
  ls                                                 list all sessions (and re-verify their boundaries)
  attach [session]                                   reattach to a running agent's terminal
  gc [--age <hours>] [--dry-run]                     reap idle session containers/networks/volumes
  reset {cache|sessions|creds|all} [--session <name>] [--dry-run]
                                                     tiered wipe of this repo's session state
  down [--session <name>]                            tear down this repo's session topology
  status [--session <name>]                          show this repo's session containers
  policy <url>                                       evaluate a URL against the active egress policy
  conformance                                        run the adversarial conformance suite
  doctor [--full]                                    check host deps, policy, guarantees (--full: + conformance)
  build [--harness ...]                              (re)build the images
EOF
}

main() {
    local cmd="${1:-}"
    [[ -n "${cmd}" ]] || { usage; exit 1; }
    shift || true
    case "${cmd}" in help|-h|--help) usage; exit 0 ;; esac
    preflight
    case "${cmd}" in
        run) cmd_run "$@" ;;
        ls) cmd_ls "$@" ;;
        attach) cmd_attach "$@" ;;
        gc) cmd_gc "$@" ;;
        reset) cmd_reset "$@" ;;
        down) cmd_down "$@" ;;
        status) cmd_status "$@" ;;
        policy) cmd_policy "$@" ;;
        conformance) cmd_conformance "$@" ;;
        doctor) cmd_doctor "$@" ;;
        build) cmd_build "$@" ;;
        help|-h|--help) usage ;;
        *) usage; exit 1 ;;
    esac
}

main "$@"
