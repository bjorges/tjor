#!/usr/bin/env bash
# tjor — run AI coding agents inside a portable, fail-closed container cage.
#
# Every entry point gets configuration through python/tjor_cfg.py (the ONE
# merge path, charter L19) and policy verdicts through python/tjor_policy.py
# (the ONE matcher, charter L4). This script orchestrates; it never decides.
set -euo pipefail

# ---------------------------------------------------------------- preflight
if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
    echo "tjor: bash >= 4.4 required (you have ${BASH_VERSION})." >&2
    echo "      macOS: brew install bash   (then run via that bash or fix PATH)" >&2
    exit 1
fi

TJOR_ROOT="$(python3 - "${BASH_SOURCE[0]}" <<'PY' 2>/dev/null || true
import os, sys
print(os.path.dirname(os.path.dirname(os.path.realpath(sys.argv[1]))))
PY
)"

# Exit codes (#40). A generic failure is 1 (usage errors, missing runtime,
# bad flags). TJOR_EXIT_BOUNDARY is reserved for ONE meaning: a required
# security boundary could not be established, so tjor refused to start (or kept
# running) the agent. Wrapping scripts, supervisors, and CI can fail closed on
# this specific code instead of pattern-matching stderr. Documented in README
# (Exit codes). The agent entrypoint uses the SAME value for its in-cage
# boundary aborts (non-root guarantee, required kernel sandbox unavailable),
# which run_agent propagates as the container exit code — keep them in sync.
readonly TJOR_EXIT_BOUNDARY=90

die() { echo "tjor: ERROR: $*" >&2; exit 1; }
die_boundary() { echo "tjor: ERROR: security boundary could not be established: $*" >&2; exit "${TJOR_EXIT_BOUNDARY}"; }
warn() { echo "tjor: WARNING: $*" >&2; }
loud() { echo -e "\033[1;31mtjor: $*\033[0m" >&2; }

preflight() {
    local missing=()
    command -v python3 >/dev/null || missing+=("python3 (>=3.11) — brew install python / apt install python3")
    if command -v python3 >/dev/null; then
        python3 -c 'import tomllib' 2>/dev/null || missing+=("python3 >= 3.11 with tomllib — current $(python3 --version)")
    fi
    command -v docker >/dev/null || missing+=("docker — https://docs.docker.com/engine/install/ or colima")
    command -v git >/dev/null || missing+=("git")
    if docker compose version >/dev/null 2>&1; then COMPOSE=(docker compose)
    elif command -v docker-compose >/dev/null 2>&1; then COMPOSE=(docker-compose)
    else missing+=("docker compose v2 (plugin or docker-compose binary) — brew install docker-compose"); fi
    command -v shasum >/dev/null || command -v sha256sum >/dev/null || missing+=("shasum or sha256sum")
    command -v openssl >/dev/null || missing+=("openssl — required to generate the constrained (pathlen:0) session CA")
    if ((${#missing[@]})); then
        echo "tjor: missing host dependencies:" >&2
        printf '  - %s\n' "${missing[@]}" >&2
        exit 1
    fi
    [[ -n "${TJOR_ROOT}" && -f "${TJOR_ROOT}/compose.yaml" ]] || die "cannot locate tjor installation root"
    docker info >/dev/null 2>&1 || die "docker daemon not reachable — is docker/colima running?"
}

sha256() {
    if command -v sha256sum >/dev/null; then sha256sum | cut -d' ' -f1
    else shasum -a 256 | cut -d' ' -f1; fi
}

cfg() { python3 "${TJOR_ROOT}/python/tjor_cfg.py" get "$@"; }

# Render an attacker-influenced string safe to echo (escape-injection defense,
# the same tjor_safeprint filter the trust review and denial log use): control
# bytes become visible tokens instead of driving the terminal.
safeprint() { printf %s "$1" | python3 "${TJOR_ROOT}/python/tjor_safeprint.py"; }

# The active policy file, most-specific first: explicit override → a TRUSTED
# repo .tjor/policy.toml → the user policy → the packaged default. A repo
# policy is honored only after `tjor trust` (it can widen egress).
repo_root() { # echoes the current repo's toplevel, or nothing
    echo "${TJOR_WORKSPACE:-$(git rev-parse --show-toplevel 2>/dev/null || true)}"
}

policy_file() {
    if [[ -n "${TJOR_POLICY_OVERRIDE:-}" ]]; then echo "${TJOR_POLICY_OVERRIDE}"; return; fi
    local root repo
    root="$(repo_root)"
    repo="${root}/.tjor/policy.toml"
    if [[ -n "${root}" && -f "${repo}" ]]; then
        if python3 "${TJOR_ROOT}/python/tjor_trust.py" check "${repo}" >/dev/null 2>&1; then
            echo "${repo}"; return
        else
            warn "repo policy ${repo} present but NOT trusted — ignored (review + approve with: tjor trust)"
        fi
    fi
    if [[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/tjor/policy.toml" ]]; then
        echo "${XDG_CONFIG_HOME:-$HOME/.config}/tjor/policy.toml"; return
    fi
    echo "${TJOR_ROOT}/config/policy.toml"
}

# ------------------------------------------------------------------- images
build_proxy() {
    docker build -q -f "${TJOR_ROOT}/images/proxy/Dockerfile" \
        --build-arg BASE_IMAGE="$(cfg images.mitmproxy)" \
        -t tjor-proxy:local "${TJOR_ROOT}" >/dev/null
}

build_agent() { # $1 = harness list (comma separated)
    local harness="$1"
    echo "tjor: building agent image (${harness}) — first build downloads pinned tools" >&2
    # No AGENT_UID build-arg: the image is uid-agnostic (default uid baked;
    # the entrypoint aligns to TJOR_AGENT_UID at start), so a local build is
    # portable and matches the published image.
    docker build -f "${TJOR_ROOT}/images/agent/Dockerfile" \
        --build-arg BASE_IMAGE="$(cfg images.debian)" \
        --build-arg HARNESS="${harness}" \
        --build-arg OPENCODE_VERSION="$(cfg versions.opencode)" \
        --build-arg OPENCODE_SHA256_ARM64="$(cfg versions.sha256.opencode_linux_arm64)" \
        --build-arg OPENCODE_SHA256_X64="$(cfg versions.sha256.opencode_linux_x64)" \
        --build-arg CLAUDE_CODE_VERSION="$(cfg versions.claude_code)" \
        --build-arg COPILOT_VERSION="$(cfg versions.copilot)" \
        --build-arg GH_VERSION="$(cfg versions.gh)" \
        --build-arg GH_SHA256_ARM64="$(cfg versions.sha256.gh_linux_arm64)" \
        --build-arg GH_SHA256_AMD64="$(cfg versions.sha256.gh_linux_amd64)" \
        --build-arg KUBECTL_VERSION="$(cfg versions.kubectl)" \
        --build-arg KUBECTL_SHA256_ARM64="$(cfg versions.sha256.kubectl_linux_arm64)" \
        --build-arg KUBECTL_SHA256_AMD64="$(cfg versions.sha256.kubectl_linux_amd64)" \
        --build-arg CPLT_VERSION="$(cfg versions.cplt)" \
        --build-arg CPLT_SHA256_ARM64="$(cfg versions.sha256.cplt_linux_arm64)" \
        --build-arg CPLT_SHA256_AMD64="$(cfg versions.sha256.cplt_linux_amd64)" \
        -t "tjor-agent-${harness//,/-}:local" "${TJOR_ROOT}"
}

build_conformance() {
    docker build -q -f "${TJOR_ROOT}/images/conformance/Dockerfile" \
        --build-arg BASE_IMAGE="$(cfg images.python)" \
        -t tjor-conformance:local "${TJOR_ROOT}" >/dev/null
}

# Pick the agent image: a prebuilt published image for this tjor version when
# available (fast first run), else a local build. A git checkout (dev) always
# builds locally — its code may differ from any published image. Images are
# uid-agnostic, so a published image serves any host user.
resolve_agent_image() { # $1 = harness ; sets TJOR_AGENT_IMAGE
    local harness="$1"
    export TJOR_AGENT_IMAGE="tjor-agent-${harness}:local"
    # Only an installed (non-git) copy pulls; a git checkout always builds
    # locally from the audited Dockerfile (the security-conscious path is
    # never silently replaced). See ADR 0008 for the trust trade-off.
    if [[ ! -d "${TJOR_ROOT}/.git" ]] && [[ "$(cfg images.publish --default true)" == "true" ]]; then
        local ver reg digest ref
        ver="$(tr -d ' \n' < "${TJOR_ROOT}/VERSION" 2>/dev/null || true)"
        reg="$(cfg images.registry --default ghcr.io/bjorges)"
        # A configured digest (images.digests.<harness>, e.g. "sha256:...")
        # gives a VERIFIED pull — exactly what you run, independent of the
        # mutable tag. Preferred; recorded per release.
        digest="$(cfg "images.digests.${harness}" --default '' 2>/dev/null || true)"
        if [[ -n "${digest}" ]]; then
            ref="${reg}/tjor-agent-${harness}@${digest}"
            if docker image inspect "${ref}" >/dev/null 2>&1 || docker pull "${ref}" >/dev/null 2>&1; then
                export TJOR_AGENT_IMAGE="${ref}"
                echo "tjor: using prebuilt image pinned by digest (${ref})" >&2
                return 0
            fi
            echo "tjor: pinned digest for ${harness} not reachable — building locally" >&2
        elif [[ -n "${ver}" ]]; then
            ref="${reg}/tjor-agent-${harness}:${ver}"
            if docker image inspect "${ref}" >/dev/null 2>&1 || docker pull "${ref}" >/dev/null 2>&1; then
                export TJOR_AGENT_IMAGE="${ref}"
                echo "tjor: using prebuilt image ${ref}" >&2
                warn "this image was pulled by TAG, not verified by digest or signature — you are trusting the registry + publish pipeline (ADR 0008). To build from source instead: set [images] publish=false, or run from a git checkout."
                return 0
            fi
            echo "tjor: no prebuilt image for ${ver} reachable — building locally" >&2
        fi
    fi
    docker image inspect "${TJOR_AGENT_IMAGE}" >/dev/null 2>&1 || build_agent "${harness}"
}

# ----------------------------------------------------------------- topology
compose() { "${COMPOSE[@]}" -f "${TJOR_ROOT}/compose.yaml" "$@"; }

is_connected() { # ctr net
    docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}' "$1" | grep -qw "$2"
}

wait_internal_ip() { # svc net -> echoes a validated IP, or fails
    local ctr ip
    for _ in $(seq 1 30); do
        ctr="$(compose ps -q "$1" 2>/dev/null || true)"
        if [[ -n "${ctr}" && "$(docker inspect -f '{{.State.Running}}' "${ctr}" 2>/dev/null)" == "true" ]]; then
            ip="$(docker inspect -f "{{(index .NetworkSettings.Networks \"$2\").IPAddress}}" "${ctr}" 2>/dev/null || true)"
            if [[ "${ip}" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
                echo "${ip}"
                return 0
            fi
        fi
        sleep 1
    done
    return 1
}

ensure_topology() { # expects TJOR_PROJECT, TJOR_SESSION_DIR exported
    local pfile session_policy corefile
    pfile="$(policy_file)"
    session_policy="${TJOR_SESSION_DIR}/policy.toml"
    corefile="${TJOR_SESSION_DIR}/Corefile"
    cp "${pfile}" "${session_policy}"

    # LLM gateway (D4): make the gateway host inference-ONLY in the session
    # policy — it joins hosts.block and only the inference paths are carved back
    # in (paths.allow), so the whole management API is denied by construction.
    # This is the ONE host the policy gains; the gateway's key is NOT here.
    if [[ -n "${TJOR_GATEWAY_ENABLED:-}" && -n "${TJOR_GATEWAY_HOST:-}" ]]; then
        local augmented
        if augmented="$(python3 "${TJOR_ROOT}/python/tjor_gateway.py" augment-policy "${session_policy}" "${TJOR_GATEWAY_HOST}")"; then
            printf '%s' "${augmented}" > "${session_policy}"
        else
            die "gateway: failed to augment the egress policy with the gateway carve-outs"
        fi
    fi

    if ! python3 "${TJOR_ROOT}/python/tjor_policy.py" validate --policy "${session_policy}" >/dev/null 2>&1; then
        loud "EGRESS POLICY INVALID (${pfile}) — failing closed: ALL egress will be denied."
        python3 "${TJOR_ROOT}/python/tjor_policy.py" validate --policy "${session_policy}" || true
    fi
    python3 "${TJOR_ROOT}/python/gen_corefile.py" --policy "${session_policy}" --out "${corefile}"

    # Identity joins the hash so an identity change (e.g. a new --task)
    # recreates the proxy with the new registration.
    # The gateway config (models — no secrets) joins the hash so a model change
    # recreates the sidecar; the master KEY is passed by env and is never here.
    TJOR_CONFIG_HASH="$( { cat "${session_policy}" "${corefile}" "${TJOR_ROOT}/compose.yaml" \
            "${TJOR_BROKER_CONFIG_MOUNT:-/dev/null}" "${TJOR_GATEWAY_CONFIG_MOUNT:-/dev/null}"; \
        printf '%s|%s|%s|%s|%s|%s|%s|%s' "${TJOR_SESSION_ID:-}" "${TJOR_TASK_ID:-}" "${TJOR_HARNESS:-}" \
            "${TJOR_REPO:-}" "${TJOR_WORKTREE:-}" "${TJOR_PARENT_SESSION:-}" "${TJOR_INJECT_HOSTS:-}" \
            "${TJOR_BROKER_HOSTS:-}"; } \
        | sha256 | cut -c1-16)"
    export TJOR_CONFIG_HASH

    build_proxy
    ensure_session_ca
    touch "${TJOR_SESSION_DIR}/denials.log"   # pre-create (bind source must exist); accumulates across the session
    touch "${TJOR_SESSION_DIR}/logvolume.log" # #50 workload-log read-volume counter (bind source must exist)
    touch "${TJOR_SESSION_DIR}/secretscan.log" # #62 egress secret-tripwire signal (bind source must exist)
    verify_bind_source "${TJOR_SESSION_DIR}"
    [[ -n "${TJOR_WORKSPACE:-}" && -d "${TJOR_WORKSPACE:-}" ]] && verify_bind_source "${TJOR_WORKSPACE}"

    # The agent network: internal-only, launcher-managed (compose sees it as
    # external so that sidecar creation happens on the egress network first).
    local internal="${TJOR_PROJECT}_internal"
    docker network inspect "${internal}" >/dev/null 2>&1 \
        || docker network create --internal --label "tjor.session=${TJOR_SESSION}" "${internal}" >/dev/null \
        || die_boundary "could not create the internal-only agent network ${internal}"

    # Recreate sidecars on config drift (charter L12): compare the stamp on
    # the running containers with the hash of the config we just generated.
    # The gateway sidecar (D4) is brought up with proxy/dns but, like them, is
    # created on the egress network — and, UNLIKE them, never connected to the
    # internal network below, so the agent can reach it only through the proxy.
    local -a svcs=(proxy dns)
    [[ -n "${TJOR_GATEWAY_ENABLED:-}" ]] && svcs+=(litellm)
    local force=() ctr stamp svc
    for svc in "${svcs[@]}"; do
        ctr="$(compose ps -q "${svc}" 2>/dev/null || true)"
        if [[ -n "${ctr}" ]]; then
            stamp="$(docker inspect -f '{{index .Config.Labels "tjor.confighash"}}' "${ctr}" 2>/dev/null || true)"
            [[ "${stamp}" != "${TJOR_CONFIG_HASH}" ]] && force=(--force-recreate)
        fi
    done
    compose up -d "${force[@]}" "${svcs[@]}"

    # Dual-homed sidecars: created on the egress network by compose, then
    # connected to the internal network SECOND (charter L28). Retry: the
    # network sandbox may lag container start by a moment.
    for svc in proxy dns; do
        ctr="$(compose ps -q "${svc}")"
        local attempt connected=""
        for attempt in $(seq 1 10); do
            if is_connected "${ctr}" "${internal}" \
               || docker network connect "${internal}" "${ctr}" 2>/dev/null; then
                connected=1; break
            fi
            sleep 1
            ctr="$(compose ps -q "${svc}")"
        done
        [[ -n "${connected}" ]] || die_boundary "could not connect ${svc} to ${internal} after ${attempt} attempts"
    done

    # Core guarantee verification: the agent network MUST be internal-only.
    if [[ "$(docker network inspect -f '{{.Internal}}' "${internal}")" != "true" ]]; then
        loud "CORE GUARANTEE FAILED: network ${internal} is not internal-only. Tearing down and aborting."
        compose down --remove-orphans >/dev/null 2>&1 || true
        exit "${TJOR_EXIT_BOUNDARY}"
    fi

    # Hand the session CA *certificate* (never the key) to the agent. The
    # launcher normally pre-generated it (constrained, L25); if openssl was
    # missing, wait for the proxy to self-generate into the shared confdir.
    local proxy_ctr ok=""
    proxy_ctr="$(compose ps -q proxy)"
    for _ in $(seq 1 30); do
        if [[ -s "${TJOR_SESSION_DIR}/proxy-ca/mitmproxy-ca-cert.pem" ]]; then ok=1; break; fi
        sleep 0.5
    done
    [[ -n "${ok}" ]] || die_boundary "no session CA appeared — check: docker logs ${proxy_ctr}"
    cp "${TJOR_SESSION_DIR}/proxy-ca/mitmproxy-ca-cert.pem" "${TJOR_SESSION_DIR}/ca.pem"

    # Readiness: wait until mitmdump actually LISTENS. (The CA used to be
    # docker-cp'd out of the proxy, which accidentally doubled as a boot
    # gate; the host-generated CA removed that, so the gate must be real.)
    local ready=""
    for _ in $(seq 1 60); do
        if docker exec "${proxy_ctr}" python3 -c \
            "import socket; socket.create_connection(('127.0.0.1', ${TJOR_PROXY_PORT}), 2).close()" \
            >/dev/null 2>&1; then ready=1; break; fi
        sleep 1
    done
    if [[ -z "${ready}" ]]; then
        echo "tjor: proxy diagnostics (state, restarts, last logs):" >&2
        docker inspect -f 'state={{.State.Status}} restarts={{.RestartCount}} exitcode={{.State.ExitCode}}' "${proxy_ctr}" >&2 || true
        docker logs --tail 40 "${proxy_ctr}" >&2 || true
        die_boundary "proxy never started listening on :${TJOR_PROXY_PORT}"
    fi

    # Discover sidecar internal IPs. Guard against not-yet-running or
    # crash-looping containers: docker 29 renders an empty IP as the literal
    # string "invalid IP", so validate the shape and retry until stable.
    TJOR_PROXY_IP="$(wait_internal_ip proxy "${internal}")" \
        || die_boundary "proxy has no internal IP (crash loop?) — check: docker logs ${proxy_ctr}"
    TJOR_DNS_IP="$(wait_internal_ip dns "${internal}")" \
        || die_boundary "dns has no internal IP (crash loop?) — check: docker logs $(compose ps -q dns)"
    export TJOR_PROXY_IP TJOR_DNS_IP

    report_tiers
}

report_tiers() {
    echo "tjor: core guarantees active: internal-only network, fail-closed egress proxy, zone-scoped DNS, non-root agent" >&2
    if docker info --format '{{join .SecurityOptions ","}}' 2>/dev/null | grep -q apparmor; then
        echo "tjor: hardening add-on available: AppArmor (profiles ship in a later tjor release)" >&2
    else
        warn "hardening add-on INACTIVE: AppArmor not supported by this container runtime (guarantee tier: core only)"
    fi
    # Kernel-sandbox tier (#9): availability is only knowable in-cage (the
    # entrypoint probes Landlock in the enforcement context and states the
    # result); here we can only surface the configured mode.
    echo "tjor: hardening add-on: kernel sandbox (Landlock, mode $(cfg landlock.mode --default auto)) — probed in-cage at start, status on the 'kernel-sandbox:' log line" >&2
}

# Best-effort container-runtime classification for the conformance attestation
# (#13): linux-engine | colima | docker-desktop | wsl2 | unknown. It NEVER
# mislabels — an unrecognized engine is reported as `unknown`, so a confident
# wrong label can't creep into an attestation. Signals in order: WSL (a host
# kernel fact, independent of the docker backend), then the docker context name,
# then `docker info` fields; a plain reachable daemon on a Linux host with no
# Desktop/Colima/WSL marker is the native engine.
detect_runtime() {
    if [[ -n "${WSL_DISTRO_NAME:-}" ]] || grep -qiE 'microsoft|wsl' /proc/version 2>/dev/null; then
        echo "wsl2"; return
    fi
    case "$(docker context show 2>/dev/null || true)" in
        colima*)        echo "colima"; return ;;
        desktop-linux)  echo "docker-desktop"; return ;;
    esac
    # One `docker info` call for both fields (OS strings/names never contain '|').
    local info os name
    info="$(docker info --format '{{.OperatingSystem}}|{{.Name}}' 2>/dev/null || true)"
    os="${info%%|*}"; name="${info#*|}"
    case "${os}" in *"Docker Desktop"*) echo "docker-desktop"; return ;; esac
    case "${name}" in colima*) echo "colima"; return ;; esac
    if [[ -n "${os}" && "$(uname -s 2>/dev/null)" == "Linux" ]]; then
        echo "linux-engine"; return
    fi
    echo "unknown"
}

# ----------------------------------------------------------------- sessions
# Write broker.json created 0o600 from the start (os.open with the mode) so
# the secret never exists briefly world-readable.
write_broker_json() { # $1 out, $2 source, then source args
    python3 - "$@" <<'PY'
import json, os, sys
out, source = sys.argv[1], sys.argv[2]
if source == "pat":
    cfg = {"source": "pat", "token": sys.argv[3]}
else:
    app, inst, keypath, repos = sys.argv[3], sys.argv[4], sys.argv[5], sys.argv[6]
    cfg = {"source": "github-app", "app_id": app, "installation_id": inst,
           "private_key": open(keypath).read(), "repositories": json.loads(repos)}
fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as fh:
    fh.write(json.dumps(cfg))
PY
}

# Agent profile (#29): stage an opted-in host profile — agents/commands/skills
# only — into the session dir, credential-safe. The allow-list filtering lives
# in tjor_profile.py and runs HOST-SIDE, so an auth.json / API key beside the
# definitions is never copied and never mounted (it cannot reach the cage). The
# entrypoint later overlays the staged dir on the image instruction cargo. Sets
# TJOR_PROFILE_STAGE (host path) when a profile is active, else leaves it empty.
prepare_profile() { # $1 = profile name (via [profiles]), $2 = ad-hoc dir
    export TJOR_PROFILE_STAGE=""
    local name="$1" adhoc="$2" src=""
    [[ -z "${name}" || -z "${adhoc}" ]] \
        || die "use --profile <name> OR --profile-dir <path>, not both"
    if [[ -n "${name}" ]]; then
        src="$(cfg "profiles.${name}" --default '')"
        [[ -n "${src}" ]] || die "no profile named '${name}' — define it under [profiles] in your tjor config"
    elif [[ -n "${adhoc}" ]]; then
        src="${adhoc}"
    else
        return 0
    fi
    src="${src/#\~/$HOME}"
    [[ -d "${src}" ]] || die "profile source is not a directory: ${src}"
    local stage="${TJOR_SESSION_DIR}/profile" staged n
    staged="$(python3 "${TJOR_ROOT}/python/tjor_profile.py" stage "${src}" "${stage}")" \
        || die "failed to stage agent profile from ${src}"
    n="$(printf '%s' "${staged}" | grep -c . || true)"
    if [[ "${n}" -eq 0 ]]; then
        warn "profile ${src} has no agent/command/skill definitions to deploy — nothing staged"
        return 0
    fi
    # Managed opencode tier (#46): a staged managed/opencode.json must be
    # valid JSON. Fail HERE — the operator gets the error where they typed
    # the profile, before any container work. The entrypoint re-validates
    # and refuses with the boundary code (defense in depth for launches
    # that bypass this launcher): a profile must never LOOK hardened
    # without BEING it.
    if [[ -f "${stage}/managed/opencode.json" ]]; then
        python3 -c 'import json, sys; json.load(open(sys.argv[1]))' \
            "${stage}/managed/opencode.json" 2>/dev/null \
            || die "profile managed/opencode.json is not valid JSON: ${src}/managed/opencode.json"
        echo "tjor: agent profile — managed opencode config staged (deployed root-owned in-cage)" >&2
    fi
    export TJOR_PROFILE_STAGE="${stage}"
    echo "tjor: agent profile — staged ${n} definition file(s) from ${src} (credentials excluded)" >&2
}

# Kube broker (#26): the current kubeconfig context's API server URL, or fail.
# Delegates all cluster-auth complexity (exec plugins, client certs, OIDC) to
# the user's working kubectl — we only read the resolved server address.
kube_server_url() {
    local server
    server="$(kubectl config view --minify -o 'jsonpath={.clusters[0].cluster.server}' 2>/dev/null)" || return 1
    [[ -n "${server}" ]] || return 1
    printf '%s' "${server}"
}

# Same, but for a NAMED context (#57 multi-cluster): read the server of the
# context a per-cluster entry mints against, so its api_host pin is validated
# against the right cluster (#58, per entry).
kube_server_url_ctx() { # $1 = kubectl context name
    local server
    server="$(kubectl config view --minify --context "$1" -o 'jsonpath={.clusters[0].cluster.server}' 2>/dev/null)" || return 1
    [[ -n "${server}" ]] || return 1
    printf '%s' "${server}"
}

prepare_broker() {
    # Credential broker (D2): assemble the broker config into the SESSION DIR
    # (mounted only into the proxy sidecar, egress side), resolving secrets
    # host-side so nothing sensitive is ever passed to the agent. Sets
    # TJOR_BROKER_* for compose. Fail-closed: any problem disables injection
    # loudly rather than silently downgrading to a long-lived token.
    export TJOR_BROKER_CONFIG_MOUNT="" TJOR_BROKER_HOSTS="" TJOR_BROKER_ENABLED="" TJOR_BROKER_DIR="" TJOR_KUBE_SERVERS="" TJOR_KUBE_CONTEXTS="" TJOR_KUBE_API_HOSTS=""
    local source; source="$(cfg broker.source --default '')"
    [[ -n "${source}" ]] || return 0
    local dir="${TJOR_SESSION_DIR}/broker"
    mkdir -p "${dir}"; chmod 700 "${dir}"
    local hosts; hosts="$(cfg broker.hosts --default '[]' \
        | python3 -c 'import json,sys; print(",".join(json.load(sys.stdin)))')"
    # broker.json is created 0o600 atomically by write_broker_json (os.open
    # with the mode), so the secret is never briefly world-readable between
    # write and a separate chmod (the dir is 700 too).
    case "${source}" in
        pat)
            local envname token; envname="$(cfg broker.pat_env --default TJOR_GITHUB_PAT)"
            token="${!envname:-}"
            [[ -n "${token}" ]] || { warn "broker source=pat but \$${envname} is empty — broker disabled"; return 0; }
            write_broker_json "${dir}/broker.json" pat "${token}" ;;
        github-app)
            local app inst keypath; app="$(cfg broker.app_id)"; inst="$(cfg broker.installation_id)"
            keypath="$(cfg broker.private_key_path)"; keypath="${keypath/#\~/$HOME}"
            [[ -n "${app}" && -n "${inst}" && -s "${keypath}" ]] \
                || { warn "broker source=github-app needs app_id, installation_id, and a readable private_key_path — broker disabled"; return 0; }
            local repos; repos="$(cfg broker.repositories --default '[]')"
            write_broker_json "${dir}/broker.json" github-app "${app}" "${inst}" "${keypath}" "${repos}" ;;
        kube)
            # Mint a short-TTL SA token host-side per cluster (kubectl does the
            # cluster auth), and inject each toward its OWN API origin ONLY as a
            # Bearer token — the scheme the Kubernetes API requires (#57). The
            # agent gets a multi-context placeholder kubeconfig and switches
            # clusters client-side; the real tokens stay in the proxy. RBAC on
            # each SA is the cluster-enforced action policy. Fail-closed and
            # ALL-OR-NOTHING: any cluster that can't validate/mint, or a
            # duplicate origin/context, disables the WHOLE broker — never a
            # session whose kubeconfig lists a context with no working token.
            command -v kubectl >/dev/null 2>&1 \
                || { warn "broker source=kube needs kubectl on the host — broker disabled"; return 0; }
            # Normalize config into TSV entries (one cluster per line:
            # context<TAB>sa<TAB>ns<TAB>ttl<TAB>api_host). The explicit
            # [[broker.kube_clusters]] list wins; else a single flat entry from
            # the back-compat keys, with an empty context = the active context.
            # [broker] is a security table, so an unknown per-entry key aborts
            # (a typo must never silently mis-scope a cluster).
            # clusters_json passed as an ARGUMENT (not stdin), so the heredoc
            # is free to carry the normalizer program (`python3 -` reads it from
            # stdin). On any validation error python exits non-zero with the
            # message on stderr (merged via 2>&1 into `entries`).
            local clusters_json entries
            clusters_json="$(cfg broker.kube_clusters --default '[]')"
            entries="$(python3 - "${clusters_json}" \
                        "$(cfg broker.kube_sa --default '')" \
                        "$(cfg broker.kube_namespace --default default)" \
                        "$(cfg broker.kube_duration --default 1h)" \
                        "$(cfg broker.kube_api_host --default '')" 2>&1 <<'PY'
import json, sys
clusters = json.loads(sys.argv[1])
flat_sa, flat_ns, flat_ttl, flat_api = sys.argv[2:6]
ALLOWED = {"context", "kube_sa", "kube_namespace", "kube_duration", "api_host"}
rows = []
if clusters:
    if not isinstance(clusters, list):
        sys.exit("broker.kube_clusters must be a list of tables")
    for i, c in enumerate(clusters):
        if not isinstance(c, dict):
            sys.exit(f"broker.kube_clusters[{i}] must be a table")
        extra = sorted(set(c) - ALLOWED)
        if extra:
            sys.exit(f"broker.kube_clusters[{i}] has unknown key(s): {extra}")
        ctx, sa = c.get("context", ""), c.get("kube_sa", "")
        if not ctx:
            sys.exit(f"broker.kube_clusters[{i}] needs 'context'")
        if not sa:
            sys.exit(f"broker.kube_clusters[{i}] needs 'kube_sa'")
        # \x1f (unit separator) between fields, NOT a tab: tab is IFS
        # whitespace, so bash `read` would trim the empty leading context
        # field and shift every column. \x1f is non-whitespace, so empty
        # fields (an unpinned entry, the flat entry's empty context) survive.
        rows.append("\x1f".join([ctx, sa, c.get("kube_namespace", "default"),
                                 c.get("kube_duration", "1h"), c.get("api_host", "")]))
else:
    if not flat_sa:
        sys.exit("needs broker.kube_sa (or a [[broker.kube_clusters]] list)")
    rows.append("\x1f".join(["", flat_sa, flat_ns or "default", flat_ttl or "1h", flat_api]))
sys.stdout.write("\n".join(rows))
PY
)" || { warn "broker source=kube: ${entries} — broker disabled"; return 0; }
            # PASS 1 — validate EVERY cluster (keys, DNS names, duration, server
            # readability, api_host pin (#58), unique origin/context) with NO
            # minting. So a bad config disables the broker before any token is
            # ever requested (spec: "before minting any cluster's token").
            local -a k_ctxnames=() k_servers=() k_apis=() k_origins=() k_sas=() k_nss=() k_ttls=() k_ctxs=() k_tokens=()
            local ctx sa ns ttl pin ctxname server api origin ctxsrv token _v o c
            while IFS=$'\x1f' read -r ctx sa ns ttl pin; do
                [[ -n "${sa}" ]] || continue
                # DNS-name + duration validation per entry (argument-injection
                # defense: a leading '-' would be read as a kubectl flag).
                for _v in "${sa}" "${ns}"; do
                    [[ "${_v}" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$ ]] \
                        || { warn "broker source=kube: invalid ServiceAccount/namespace '${_v}' (lowercase DNS name; no leading '-') — broker disabled"; return 0; }
                done
                [[ "${ttl}" =~ ^[0-9]+[smh]$ ]] \
                    || { warn "broker source=kube: invalid kube_duration '${ttl}' (e.g. 3600s, 30m, 1h) — broker disabled"; return 0; }
                # A list entry's context name must be flag-safe (it is passed to
                # kubectl as `--context <ctx>`) AND comma-free: context names are
                # serialized comma-joined into TJOR_KUBE_CONTEXTS and re-split by
                # the entrypoint, so a comma would desync the context↔server
                # pairing and point a context at the wrong cluster's server.
                if [[ -n "${ctx}" ]]; then
                    [[ "${ctx}" != -* ]] \
                        || { warn "broker source=kube: invalid context name '${ctx}' (must not start with '-') — broker disabled"; return 0; }
                    [[ "${ctx}" != *,* ]] \
                        || { warn "broker source=kube: invalid context name '${ctx}' (must not contain a comma) — broker disabled"; return 0; }
                fi
                # Determine the server for this entry and validate any api_host
                # pin against the context it is minted against (#58, per entry).
                if [[ -n "${pin}" ]]; then
                    server="${pin}"
                    if [[ -n "${ctx}" ]]; then ctxsrv="$(kube_server_url_ctx "${ctx}")"; else ctxsrv="$(kube_server_url)"; fi \
                        || { warn "broker source=kube: api_host is set for '${ctx:-active context}' but that context's server could not be read, so the pin cannot be validated against the cluster the token would be minted for — fix the context or unset api_host. Broker disabled."; return 0; }
                    python3 "${TJOR_ROOT}/python/tjor_kube.py" same "${pin}" "${ctxsrv}" 2>/dev/null \
                        || { warn "broker source=kube: api_host ('${pin}') does not name the server of context '${ctx:-active}' ('${ctxsrv}') — token and injection scope would refer to different clusters. Fix api_host or the context. Broker disabled."; return 0; }
                else
                    if [[ -n "${ctx}" ]]; then server="$(kube_server_url_ctx "${ctx}")"; else server="$(kube_server_url)"; fi \
                        || { warn "broker source=kube: could not read the API server for context '${ctx:-active}' ('kubectl config view --minify') — set api_host or fix the context. Broker disabled."; return 0; }
                fi
                server="$(python3 "${TJOR_ROOT}/python/tjor_kube.py" url "${server}" 2>/dev/null)" \
                    && api="$(python3 "${TJOR_ROOT}/python/tjor_kube.py" host "${server}" 2>/dev/null)" \
                    && origin="$(python3 "${TJOR_ROOT}/python/tjor_kube.py" origin "${server}" 2>/dev/null)" \
                    || { warn "broker source=kube: could not parse an API host from the server URL for context '${ctx:-active}' — broker disabled"; return 0; }
                # The api host and origin feed comma-joined env lists
                # (TJOR_KUBE_API_HOSTS / TJOR_BROKER_HOSTS), so a comma in them
                # would desync the lists — refuse it (parity with the context
                # comma check; belt-and-suspenders over same_server, #57 review).
                case "${api}${origin}" in
                    *,*) warn "broker source=kube: the API host/origin for context '${ctx:-active}' contains a comma (host='${api}', origin='${origin}') — refusing (would desync the env lists). Broker disabled."; return 0 ;;
                esac
                # Context name in the agent's kubeconfig: the configured name for
                # a list entry, "tjor" for the single flat entry (unchanged).
                ctxname="${ctx:-tjor}"
                # Refuse ambiguity: an origin can carry only one token; a context
                # name can name only one cluster.
                for o in ${k_origins[@]+"${k_origins[@]}"}; do
                    [[ "${o}" == "${origin}" ]] && { warn "broker source=kube: two clusters resolve to the same API origin '${origin}' — an origin cannot carry two tokens. Broker disabled."; return 0; }
                done
                for c in ${k_ctxnames[@]+"${k_ctxnames[@]}"}; do
                    [[ "${c}" == "${ctxname}" ]] && { warn "broker source=kube: duplicate context name '${ctxname}' — broker disabled."; return 0; }
                done
                k_ctxnames+=("${ctxname}"); k_servers+=("${server}"); k_apis+=("${api}"); k_origins+=("${origin}")
                k_sas+=("${sa}"); k_nss+=("${ns}"); k_ttls+=("${ttl}"); k_ctxs+=("${ctx}")
            done <<<"${entries}"
            [[ "${#k_origins[@]}" -gt 0 ]] \
                || { warn "broker source=kube: no clusters were configured — broker disabled"; return 0; }
            # PASS 2 — mint each validated cluster. A mint failure still disables
            # the WHOLE broker (all-or-nothing); the tokens already minted are
            # simply discarded (broker.json is never written or exported).
            #
            # ACCEPTED RESIDUAL RISK (#58): for the FLAT/back-compat entry (empty
            # context), the active context is read for validation in pass 1 and
            # again, implicitly, by `kubectl create token` here — two reads. A
            # `kubectl config use-context` racing between them could mint against
            # a context different from the one validated. This is a HOST-SIDE
            # race the operator controls at launch, not an agent-reachable
            # surface (the cage is not up yet). List entries mint with an
            # explicit `--context`, which NARROWS this window; the flat path
            # keeps the pre-#57 behavior. Bounded and accepted, documented so it
            # stays a conscious choice.
            local _i
            for _i in "${!k_origins[@]}"; do
                if [[ -n "${k_ctxs[_i]}" ]]; then
                    token="$(kubectl create token "${k_sas[_i]}" --context "${k_ctxs[_i]}" --namespace "${k_nss[_i]}" --duration "${k_ttls[_i]}" 2>/dev/null)"
                else
                    token="$(kubectl create token "${k_sas[_i]}" --namespace "${k_nss[_i]}" --duration "${k_ttls[_i]}" 2>/dev/null)"
                fi \
                    || { warn "broker source=kube: 'kubectl create token ${k_sas[_i]} -n ${k_nss[_i]}${k_ctxs[_i]:+ --context ${k_ctxs[_i]}}' failed — your kubectl identity needs 'create' on the SA's serviceaccounts/token subresource, and the SA must exist. Broker disabled."; return 0; }
                [[ -n "${token}" ]] \
                    || { warn "broker source=kube: kubectl returned an empty token for context '${k_ctxs[_i]:-active}' — broker disabled"; return 0; }
                k_tokens+=("${token}")
                echo "tjor: kube broker — minted a short-TTL token for ${k_ctxnames[_i]} (SA ${k_nss[_i]}/${k_sas[_i]}); allow the API host in your egress policy:  tjor policy add ${k_apis[_i]}" >&2
            done
            # Assemble the v2 broker.json (source=kube, per-origin tokens). The
            # program is in -c so STDIN is free for the tokens — they go over
            # stdin, never argv, so no secret lands in a process listing; the
            # origins (non-secret) are argv, parallel to the token lines.
            local t
            { for t in "${k_tokens[@]}"; do printf '%s\n' "${t}"; done; } \
                | TJOR_ROOT="${TJOR_ROOT}" python3 -c '
import os, sys
sys.path.insert(0, os.path.join(os.environ["TJOR_ROOT"], "python"))
import tjor_broker
out, origins = sys.argv[1], sys.argv[2:]
tokens = sys.stdin.read().splitlines()
# strict=True: origins (argv) and tokens (stdin lines) are built in parallel by
# the launcher, so a length mismatch is a bug — fail loudly, never silently
# pair the wrong token to an origin.
tjor_broker.write_kube_broker_json(out, zip(origins, tokens, strict=True))
' "${dir}/broker.json" ${k_origins[@]+"${k_origins[@]}"} \
                || { warn "broker source=kube: failed to write broker.json — broker disabled"; return 0; }
            local IFS=,
            hosts="${k_origins[*]}"                          # inject each token toward its exact origin (#49)
            export TJOR_KUBE_SERVERS="${k_servers[*]}"       # per-cluster servers the agent renders contexts for
            export TJOR_KUBE_CONTEXTS="${k_ctxnames[*]}"     # parallel context names
            export TJOR_KUBE_API_HOSTS="${k_apis[*]}"        # scoped SSRF-guard exemption per cluster (#45)
            ;;
        *) warn "unknown broker.source '${source}' — broker disabled"; return 0 ;;
    esac
    export TJOR_BROKER_CONFIG_MOUNT="${dir}/broker.json"
    export TJOR_BROKER_DIR="${dir}"
    export TJOR_BROKER_HOSTS="${hosts}"
    export TJOR_BROKER_ENABLED=1
    echo "tjor: credential broker active (source=${source}) — the agent holds only a placeholder" >&2
}

# LLM gateway (D4): when [gateway] enabled, obtain the per-install master key
# (0600, under the user config dir — never the session dir/hash/labels), render
# the LiteLLM config from [gateway].models into an egress-side mount, stage the
# provider keys into an env_file mounted ONLY into the gateway, and export the
# TJOR_GATEWAY_* env that ensure_topology + compose read. The master key is
# passed by env to the proxy (which injects it toward the gateway host) and the
# litellm sidecar; the agent gets only a placeholder key + the gateway base_url.
prepare_gateway() {
    export TJOR_GATEWAY_ENABLED="" TJOR_GATEWAY_HOST="" TJOR_GATEWAY_KEY="" \
           TJOR_GATEWAY_PORT="" TJOR_GATEWAY_DIR="" TJOR_GATEWAY_CONFIG_MOUNT="" \
           TJOR_GATEWAY_ENV_MOUNT="" TJOR_GATEWAY_OPENAI_BASE="" \
           TJOR_GATEWAY_ANTHROPIC_BASE="" TJOR_GATEWAY_AGENT_KEY=""
    [[ "$(cfg gateway.enabled --default false)" == "true" ]] || return 0
    local host port; host="$(cfg gateway.host --default tjor-gateway)"
    port="$(cfg gateway.port --default 4000)"
    # The gateway host is an internal docker alias that we add to hosts.block —
    # a dotted / real-domain value (e.g. github.com) would then silently block
    # normal egress to it. Require a simple DNS label; refuse otherwise.
    [[ "${host}" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] \
        || { warn "gateway: [gateway].host '${host}' must be a simple hostname label (e.g. tjor-gateway), not a dotted domain — gateway disabled"; return 0; }
    local key
    key="$(python3 "${TJOR_ROOT}/python/tjor_gateway.py" master-key 2>/dev/null)" \
        || { warn "gateway: could not obtain the master key — gateway disabled"; return 0; }
    [[ -n "${key}" ]] || { warn "gateway: empty master key — gateway disabled"; return 0; }

    local gwdir="${TJOR_SESSION_DIR}/gateway"
    mkdir -p "${gwdir}"; chmod 700 "${gwdir}"
    # LiteLLM config (models only, NO secrets — provider keys are os.environ refs).
    local models; models="$(cfg gateway.models --default '[]')"
    if ! python3 "${TJOR_ROOT}/python/tjor_gateway.py" render-config "${models}" > "${gwdir}/config.yaml"; then
        warn "gateway: LiteLLM config render failed — gateway disabled"; rm -f "${gwdir}/config.yaml"; return 0
    fi
    # Provider keys -> an env_file mounted ONLY into the gateway sidecar (egress
    # side): values read from the launcher env; 0600; never mounted to the agent.
    local envfile="${gwdir}/provider.env"
    ( umask 077; : > "${envfile}" )
    local var val
    while read -r var; do
        [[ -n "${var}" ]] || continue
        val="${!var:-}"
        [[ -n "${val}" ]] || { warn "gateway: provider_key_env \$${var} is empty on the host — skipped"; continue; }
        printf '%s=%s\n' "${var}" "${val}" >> "${envfile}"
    done < <(cfg gateway.provider_key_envs --default '[]' \
                | python3 -c 'import json,sys; [print(x) for x in json.load(sys.stdin) if isinstance(x, str)]')

    local litellm_img gw_mem
    litellm_img="$(cfg images.litellm --default 'ghcr.io/berriai/litellm:main-stable')"
    gw_mem="$(cfg limits.gateway_mem --default 2g)"
    export TJOR_GATEWAY_ENABLED=1 TJOR_GATEWAY_HOST="${host}" TJOR_GATEWAY_KEY="${key}" \
           TJOR_GATEWAY_PORT="${port}" TJOR_GATEWAY_DIR="${gwdir}" \
           TJOR_GATEWAY_CONFIG_MOUNT="${gwdir}/config.yaml" TJOR_GATEWAY_ENV_MOUNT="${envfile}" \
           TJOR_GATEWAY_OPENAI_BASE="http://${host}:${port}/v1" \
           TJOR_GATEWAY_ANTHROPIC_BASE="http://${host}:${port}" \
           TJOR_GATEWAY_AGENT_KEY="tjor-gateway-placeholder" \
           TJOR_LITELLM_IMAGE="${litellm_img}" TJOR_GATEWAY_MEM="${gw_mem}"
    echo "tjor: LLM gateway active (${host}:${port}) — inference-only; admin unreachable by construction; the master key never enters the agent" >&2
}

export_static_env() {
    # Strict config validation (#39): warn loudly on unknown config keys once
    # per launch (a typo silently falling back to a default is a security-
    # relevant footgun). Non-blocking — EXCEPT under the security-enforcing
    # tables ([landlock]/[broker]), where a typo'd key silently weakening the
    # boundary is exactly the unattended/CI failure mode, so check exits
    # nonzero and the launch aborts. The per-key cfg() reads stay quiet.
    python3 "${TJOR_ROOT}/python/tjor_cfg.py" check \
        || die "config validation failed (see above)"
    export TJOR_PROXY_IMAGE="tjor-proxy:local"
    TJOR_COREDNS_IMAGE="$(cfg images.coredns)"
    TJOR_PROXY_PORT="$(cfg proxy.port --default 8080)"
    TJOR_IP_GUARD="$([ "$(cfg proxy.ip_guard --default true)" = "false" ] && echo off || echo on)"
    TJOR_AGENT_MEM="$(cfg limits.agent_mem --default 4g)"
    TJOR_PROXY_MEM="$(cfg limits.proxy_mem --default 1g)"
    TJOR_DNS_MEM="$(cfg limits.dns_mem --default 256m)"
    TJOR_CONFORMANCE_MEM="$(cfg limits.conformance_mem --default 512m)"
    TJOR_AGENT_PIDS="$(cfg limits.agent_pids --default 4096)"   # #10: fork-bomb ceiling
    TJOR_SECRET_SCAN_MAX_BYTES="$(cfg secrets.scan_max_bytes --default 262144)"  # #62 tripwire scan cap
    # Kernel-sandbox tier (#9): the Landlock mode for the entrypoint's
    # probe/wrap. Pre-validated here for a friendly host-side error; the
    # entrypoint re-validates (it is the enforcement point). Dotenv masking
    # (the deny_paths/mask_dotenv config) is consumed launcher-side in
    # run_agent — Landlock cannot deny in-tree paths, mounts can.
    TJOR_LANDLOCK="$(cfg landlock.mode --default auto)"
    case "${TJOR_LANDLOCK}" in
        auto|require|off) ;;
        *) die "invalid landlock.mode '${TJOR_LANDLOCK}' — must be auto, require, or off" ;;
    esac
    export TJOR_COREDNS_IMAGE TJOR_PROXY_PORT TJOR_IP_GUARD
    export TJOR_AGENT_MEM TJOR_PROXY_MEM TJOR_DNS_MEM TJOR_CONFORMANCE_MEM TJOR_AGENT_PIDS
    export TJOR_SECRET_SCAN_MAX_BYTES
    export TJOR_LANDLOCK
}

ensure_session_ca() {
    # Pre-generate the session MITM CA with the charter L25 constraints:
    # pathlen:0 (key disclosure yields leaf-only interception, never a
    # delegable intermediate) and EKU serverAuth. mitmproxy reads it from
    # its confdir; only the certificate is ever handed to the agent.
    local cadir="${TJOR_SESSION_DIR}/proxy-ca"
    mkdir -p "${cadir}"
    chmod 700 "${cadir}"
    [[ -s "${cadir}/mitmproxy-ca.pem" ]] && return 0
    if command -v openssl >/dev/null 2>&1; then
        openssl req -x509 -newkey rsa:2048 -nodes -days 365 \
            -keyout "${cadir}/ca-key.pem" -out "${cadir}/mitmproxy-ca-cert.pem" \
            -subj "/CN=tjor session CA/O=tjor" \
            -addext "basicConstraints=critical,CA:TRUE,pathlen:0" \
            -addext "keyUsage=critical,keyCertSign,cRLSign" \
            -addext "extendedKeyUsage=serverAuth" >/dev/null 2>&1
        cat "${cadir}/ca-key.pem" "${cadir}/mitmproxy-ca-cert.pem" > "${cadir}/mitmproxy-ca.pem"
        chmod 600 "${cadir}/ca-key.pem" "${cadir}/mitmproxy-ca.pem"
        chmod 644 "${cadir}/mitmproxy-ca-cert.pem"
        if ! openssl x509 -in "${cadir}/mitmproxy-ca-cert.pem" -text -noout | grep -q "pathlen:0"; then
            warn "generated session CA lacks pathlen:0 — check your openssl version"
        fi
    else
        warn "openssl not found — the proxy will self-generate an UNCONSTRAINED CA (no pathlen:0). Install openssl for the constrained one."
    fi
}

verify_bind_source() {
    # VM-based runtimes (Colima, Docker Desktop) share only configured host
    # paths; a bind source outside them silently appears EMPTY inside the
    # VM. Compare: if the dir has content on the host, a container must see
    # content too.
    local dir="$1"
    [[ -n "$(ls -A "${dir}" 2>/dev/null)" ]] || return 0   # empty on host: nothing to compare
    if ! docker run --rm -v "${dir}:/tjor-check:ro" --entrypoint /bin/sh "${TJOR_PROXY_IMAGE}" \
            -c '[ -n "$(ls -A /tjor-check)" ]' >/dev/null 2>&1; then
        die "${dir} is not shared with the Docker VM — bind mounts of it appear EMPTY in containers. Move it under \$HOME or add it to the VM's shared paths (colima/Docker Desktop file sharing)."
    fi
}

# The workspace-derived base session id: <repo basename, sanitized and
# lowercased>-<8 hex chars of the workspace-path hash>. The ONE derivation,
# shared by resolve_session and cmd_attach — a second copy drifting would
# reintroduce exactly the mismatch class #52 is about.
session_base_id() { # $1 = workspace path
    echo "$(basename "$1" | tr -cd 'a-zA-Z0-9_.-' | tr '[:upper:]' '[:lower:]')-$(printf %s "$1" | sha256 | cut -c1-8)"
}

# Resolve a session's identity + topology env (id, dirs, project, compose env)
# with NO side effects — no credential minting. Read-only and teardown commands
# (status/down/reset/denials) use this directly so they never assemble broker
# material; under a kube broker source, session_setup would otherwise mint a
# real short-TTL ServiceAccount token against the cluster just to resolve a path.
resolve_session() { # $1 = harness, $2 = task id (optional), $3 = session name (optional), $4 = "launch" on the run path
    local ws root sid in_repo=""
    if ws="$(git rev-parse --show-toplevel 2>/dev/null)"; then in_repo=1; else
        # PHYSICAL path (pwd -P), matching git's own canonicalized toplevel
        # and the --dir/--dir-ro resolution: a logical (symlinked) spelling
        # here would compare in a different namespace than the extras and
        # let a symlinked workspace evade the mixed-writability overlap
        # refusal (re-review of v0.17.1).
        ws="$(pwd -P)"
        warn "not inside a git repository — using ${ws} as the workspace"
    fi
    # shellcheck disable=SC2088  # literal ~ is expanded on the next line
    root="$(cfg session.root --default "~/.tjor/sessions")"; root="${root/#\~/$HOME}"
    local base
    base="$(session_base_id "${ws}")"
    sid="${base}"
    # Named sessions (D3): the name folds into the id, so every downstream
    # per-session resource (topology, state root, identity, CA) separates
    # automatically (charter L29).
    #
    # --session canonicalization (#52): tjor's own messages display the
    # FULLY-QUALIFIED id (<repo>-<hash8>[-<name>]). Blindly re-prefixing a
    # pasted one would construct a doubled phantom id — and tear down (or
    # collide with) the wrong session. So resolution is idempotent for this
    # workspace's qualified ids, honors another workspace's EXISTING qualified
    # id verbatim for lifecycle commands (refused at launch: launching this
    # workspace under a foreign identity is never derived silently), and
    # disambiguates a qualified-LOOKING value against reality (state dir or
    # labeled containers) so unusual short names keep working.
    if [[ -n "${3:-}" ]]; then
        local name short=""
        name="$(tr '[:upper:]' '[:lower:]' <<<"$3")"
        if [[ "${name}" == "${base}" ]]; then
            echo "tjor: --session ${name} is this workspace's fully-qualified default session id — resolving to the default session" >&2
        elif [[ "${name}" == "${base}-"* ]]; then
            short="${name#"${base}-"}"
            # An empty remainder (trailing dash) is a truncated paste, not a
            # request for the default session — resolving it silently would
            # target the wrong session, the exact failure class #52 is about.
            [[ -n "${short}" ]] || die "--session ${name} is this workspace's session prefix with nothing after the dash — a truncated fully-qualified id? (the default session is ${base})"
            echo "tjor: --session ${name} is already fully qualified — resolving to short name '${short}'" >&2
        elif [[ "${name}" =~ ^[a-z0-9._-]+-[0-9a-f]{8}(-[a-z0-9._-]{1,32})?$ ]]; then
            # Qualified-LOOKING: disambiguate against reality — state dir
            # first (no daemon needed), else labeled containers. If Docker
            # itself is unreachable we cannot tell, so refuse rather than
            # guess: misclassifying a real foreign id as a fresh short name
            # would fail open.
            local exists="" ctrs
            [[ -d "${root}/${name}" ]] && exists=1
            if [[ -z "${exists}" ]]; then
                ctrs="$(docker ps -aq --filter "label=tjor.session=${name}" 2>/dev/null)" \
                    || die "--session ${name} looks like a fully-qualified session id, but Docker is unreachable so tjor cannot tell whether that session exists — start docker/colima and retry"
                [[ -n "${ctrs}" ]] && exists=1
            fi
            if [[ -n "${exists}" ]]; then
                if [[ "${4:-}" == "launch" ]]; then
                    die "--session ${name} is the fully-qualified id of another workspace's session — launch from that workspace, or pick a short name for a new session here"
                fi
                echo "tjor: --session ${name} matches an existing session's fully-qualified id — using it verbatim (workspace-independent)" >&2
                sid="${name}"
            else
                echo "tjor: note: --session ${name} looks like a fully-qualified session id, but no such session exists — treating it as a short name" >&2
                short="${name}"
            fi
        else
            short="${name}"
        fi
        if [[ -n "${short}" ]]; then
            [[ "${short}" =~ ^[A-Za-z0-9._-]{1,32}$ ]] || die "--session must match [A-Za-z0-9._-]{1,32}"
            sid="${base}-${short}"
        fi
    fi
    TJOR_LAUNCHED_AT="$(date +%s)"
    export TJOR_LAUNCHED_AT

    # Session identity (D1): frozen at launch, delivered to the agent (env)
    # and to the proxy (x-agent-* verification / opt-in injection).
    export TJOR_SESSION_ID="${sid}"
    export TJOR_HARNESS="$1"
    TJOR_REPO="$(basename "${ws}" | tr -cd 'a-zA-Z0-9_.-')"
    export TJOR_REPO
    TJOR_WORKTREE=""
    if [[ -n "${in_repo}" ]]; then
        local gitdir commondir
        gitdir="$(git rev-parse --absolute-git-dir 2>/dev/null || true)"
        commondir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
        [[ -n "${gitdir}" && -n "${commondir}" && "${gitdir}" != "${commondir}" ]] && TJOR_WORKTREE="${ws}"
    fi
    export TJOR_WORKTREE
    if [[ -n "${2:-}" ]]; then
        [[ "$2" =~ ^[A-Za-z0-9._-]{1,64}$ ]] || die "--task must match [A-Za-z0-9._-]{1,64}"
        export TJOR_TASK_ID="$2"
    else
        export TJOR_TASK_ID=""
    fi
    export TJOR_PARENT_SESSION="${TJOR_PARENT_SESSION:-}"
    TJOR_INJECT_HOSTS="$(cfg identity.inject_hosts --default '[]' \
        | python3 -c 'import json,sys; print(",".join(json.load(sys.stdin)))')"
    export TJOR_INJECT_HOSTS

    export TJOR_SESSION="${sid}"
    export TJOR_PROJECT="tjor-${sid}"
    export TJOR_SESSION_DIR="${root}/${sid}"
    export TJOR_WORKSPACE="${ws}"
    export TJOR_REPO_ROOT="${ws}"   # let tjor_cfg pick up a trusted repo .tjor/config.toml
    TJOR_LAUNCH_DIR="$(pwd)"
    export TJOR_LAUNCH_DIR
    export TJOR_AGENT_IMAGE="tjor-agent-$1:local"
    TJOR_AGENT_UID="$(id -u)"; export TJOR_AGENT_UID   # runtime uid alignment (uid-agnostic image)
    export_static_env
    mkdir -p "${TJOR_SESSION_DIR}/home"
}

# Full launch setup: resolve the session AND assemble broker material (which may
# mint a live credential). Only the launch path (cmd_run) uses this — the
# "launch" marker makes resolve_session REFUSE a foreign fully-qualified
# session id here (lifecycle commands honor one; a launch never does).
session_setup() { # $1 = harness, $2 = task id (optional), $3 = session name (optional)
    resolve_session "${1}" "${2}" "${3}" launch
    prepare_broker
    prepare_gateway
    prepare_secret_scan   # #62: after prepare_gateway (needs the gateway host)
}

# Egress secret tripwire (#62): the inference hosts whose request bodies the
# proxy scans = the configured `secrets.scan_hosts` PLUS the gateway host when
# the gateway is enabled (the clean inference chokepoint). Empty => the proxy
# scans nothing. Comma-joined, like TJOR_INJECT_HOSTS.
prepare_secret_scan() {
    local hosts; hosts="$(cfg secrets.scan_hosts --default '[]' \
        | python3 -c 'import json,sys; print(",".join(json.load(sys.stdin)))')"
    if [[ -n "${TJOR_GATEWAY_ENABLED:-}" && -n "${TJOR_GATEWAY_HOST:-}" ]]; then
        hosts="${hosts:+${hosts},}${TJOR_GATEWAY_HOST}"
    fi
    export TJOR_SECRET_SCAN_HOSTS="${hosts}"
}

# True (0) if an absolute path is too sensitive to mount read-write into the
# agent without an explicit override: the filesystem root and system dirs, the
# home directory itself or an ancestor of it (which would expose credentials),
# and known credential directories.
dir_is_sensitive() { # $1 = absolute path (already symlink-resolved by pwd -P)
    local p="$1" s home="${HOME%/}"   # strip any trailing slash so ${home}/x matches
    case "${p}" in
        / | /etc | /etc/* | /root | /root/* | /boot | /boot/* | /sys | /sys/* \
        | /proc | /proc/* | /dev | /dev/* \
        | /usr | /usr/* | /var | /var/* | /bin | /bin/* | /sbin | /sbin/* \
        | /private/etc | /private/etc/* | /private/var | /private/var/* \
        | /System | /System/*) return 0 ;;   # macOS resolves /etc,/var to /private/*
    esac
    [[ "${p}" == "${home}" || "${home}" == "${p}/"* ]] && return 0
    # Credential / secret-store directories. Secret Service keyrings and pass'
    # store are independently mountable and hold live secrets.
    for s in .ssh .aws .gnupg .kube .docker .config .gcloud .azure \
             .local/share/keyrings .password-store; do
        [[ "${p}" == "${home}/${s}" || "${p}" == "${home}/${s}/"* ]] && return 0
    done
    return 1
}

cmd_run() {
    local harness="opencode" task="" name="" detach="" unsafe_dir="" profile="" profile_dir=""
    local -a extra_dirs=() extra_dirs_ro=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --harness) harness="$2"; shift 2 ;;
            --task) task="$2"; shift 2 ;;
            --session) name="$2"; shift 2 ;;
            --dir) extra_dirs+=("$2"); shift 2 ;;
            --dir-ro) extra_dirs_ro+=("$2"); shift 2 ;;
            --unsafe-dir) unsafe_dir=1; shift ;;
            --profile) profile="$2"; shift 2 ;;
            --profile-dir) profile_dir="$2"; shift 2 ;;
            --detach|-d) detach=1; shift ;;
            --) shift; break ;;
            *) break ;;
        esac
    done
    session_setup "${harness}" "${task}" "${name}"
    prepare_profile "${profile}" "${profile_dir}"
    # Multi-repo (--dir): resolve each to an absolute path now (existence
    # check); VM-share verification + mounting happen in run_agent, after the
    # proxy image (used by the share check) is built. Refuse sensitive host
    # paths (root, home, credential dirs) — mounting them read-write would
    # dissolve exactly the boundary tjor exists to enforce — unless
    # --unsafe-dir is given. Dedupe (against the primary and each other).
    TJOR_EXTRA_DIRS=()
    local d abs seen
    for d in "${extra_dirs[@]}"; do
        [[ -d "${d}" ]] || die "--dir path does not exist or is not a directory: ${d}"
        abs="$(cd "${d}" && pwd -P)" || die "--dir path unreadable: ${d}"
        [[ "${abs}" == "${TJOR_WORKSPACE}" ]] && continue   # primary already mounted
        for seen in "${TJOR_EXTRA_DIRS[@]:-}"; do [[ "${abs}" == "${seen}" ]] && continue 2; done
        if [[ -z "${unsafe_dir}" ]] && dir_is_sensitive "${abs}"; then
            die "refusing to mount sensitive host path into the agent: ${abs} (pass --unsafe-dir to override — this exposes it read-write to the agent)"
        fi
        TJOR_EXTRA_DIRS+=("${abs}")
    done
    # Read-only extras (--dir-ro, #44): same resolution and refusal rules as
    # --dir — the sensitive-path gate applies unchanged, because read-only
    # access still exposes content for exfiltration. A path given BOTH ways
    # is an ambiguous writability intent and aborts rather than silently
    # picking one: "ro wins" surprises scripts that append flags, "rw wins"
    # weakens the stricter intent — the wrong failure direction here.
    TJOR_EXTRA_DIRS_RO=()
    for d in "${extra_dirs_ro[@]}"; do
        [[ -d "${d}" ]] || die "--dir-ro path does not exist or is not a directory: ${d}"
        abs="$(cd "${d}" && pwd -P)" || die "--dir-ro path unreadable: ${d}"
        [[ "${abs}" == "${TJOR_WORKSPACE}" ]] \
            && die "--dir-ro ${abs} is the primary workspace, which is always writable — launch from another directory to attach this one read-only"
        for seen in "${TJOR_EXTRA_DIRS[@]:-}"; do
            [[ "${abs}" == "${seen}" ]] \
                && die "conflicting mounts: ${abs} is given via both --dir and --dir-ro — pick one writability"
        done
        for seen in "${TJOR_EXTRA_DIRS_RO[@]:-}"; do [[ "${abs}" == "${seen}" ]] && continue 2; done
        if [[ -z "${unsafe_dir}" ]] && dir_is_sensitive "${abs}"; then
            die "refusing to mount sensitive host path into the agent: ${abs} (pass --unsafe-dir to override — even read-only, this exposes its contents to the agent)"
        fi
        TJOR_EXTRA_DIRS_RO+=("${abs}")
    done
    # Overlapping roots with DIFFERENT writability classes are refused, in
    # BOTH directions (release review of v0.16.0/v0.17.0): a writable child
    # bind under a :ro parent stays writable inside the container; a
    # writable parent's '<root>/*' git trust would cover repos inside a
    # nested read-only child; and Landlock grants are additive, so a broad
    # writable-parent grant cannot be subtracted for a read-only child.
    # One refusal keeps all three guarantees true. Containment is judged on
    # path-component boundaries (the '/' in the pattern): /a/b overlaps
    # /a/b/c, never /a/b-other. Same-class nesting stays allowed — it
    # contradicts nothing. The entrypoint re-refuses for non-launcher
    # starts (spec: session-launch).
    local ro_root w_root
    for ro_root in "${TJOR_EXTRA_DIRS_RO[@]:-}"; do
        [[ -n "${ro_root}" ]] || continue
        for w_root in "${TJOR_WORKSPACE}" "${TJOR_EXTRA_DIRS[@]:-}"; do
            [[ -n "${w_root}" ]] || continue
            if [[ "${ro_root}" == "${w_root}"/* ]]; then
                die "conflicting mount writability: read-only ${ro_root} is nested inside writable ${w_root} — the writable parent would re-grant and git-trust the read-only tree; mount the roots disjointly"
            elif [[ "${w_root}" == "${ro_root}"/* ]]; then
                die "conflicting mount writability: writable ${w_root} is nested inside read-only ${ro_root} — the nested bind stays writable, so the read-only tree claim would be false; mount the roots disjointly"
            fi
        done
    done
    resolve_agent_image "${harness}"
    # Collision guard: a session id already backing a running agent must not
    # be launched again — a second unnamed `tjor run` in the same workspace
    # would otherwise share this one's CA/network/identity, and a later
    # `tjor down`/`gc` would tear down both at once. Refuse with a clear path
    # forward (attach, or name the second session).
    if docker ps -q --filter "label=tjor.role=agent" --filter "label=tjor.session=${TJOR_SESSION}" --filter status=running | grep -q .; then
        # Every command shown here is paste-safe verbatim (#52): attach takes
        # the full id, and --session resolves a full id idempotently.
        die "session ${TJOR_SESSION} is already running — reattach with 'tjor attach ${TJOR_SESSION}', tear it down with 'tjor down --session ${TJOR_SESSION}', or start a separate one with a different --session <name>"
    fi
    ensure_topology
    echo "tjor: session ${TJOR_SESSION} — workspace ${TJOR_WORKSPACE}" >&2
    local -a agent_cmd=()
    if [[ $# -gt 0 ]]; then agent_cmd=("$@")
    else case "${harness}" in claude) agent_cmd=(claude) ;; copilot) agent_cmd=(copilot) ;; *) agent_cmd=(opencode) ;; esac; fi
    run_agent "${detach}" "${agent_cmd[@]}"
}

# Launch the agent DETACHED and persistent, then (unless --detach) attach to
# it. Detached + no --rm is what makes `tjor attach` meaningful: the
# container outlives the launching terminal, so a dropped connection leaves a
# session to reattach to (compose run --rm would delete it the moment the
# client went away). Cleanup is `tjor down` / `tjor gc`, not --rm.
run_agent() { # $1 = detach flag, $2.. = command
    local detach="$1"; shift
    local ctr running code
    # Multi-repo: verify (proxy image now exists) and mount each extra dir at
    # its host path, writable.
    local -a mounts=() dir safe=()
    # git safe.directory is scoped to exactly the mounted repos (not '*'), so
    # only paths the operator mounted are trusted by git (see the entrypoint).
    # The list is passed NEWLINE-delimited, not ':'-delimited: a directory path
    # may legally contain a colon on Linux, which a ':' separator would
    # mis-split — trusting the wrong path and leaving the real repo untrusted.
    # A newline in a mount path is pathological (git can't represent it in a
    # config value either) and is refused below.
    #
    # CONTRACT (consumed by the entrypoint): TJOR_SAFE_DIRS is the durable
    # in-container record of every operator-approved mount root, and
    # TJOR_RO_DIRS the subset mounted read-only — together they carry each
    # root's writability class. The writability class is load-bearing for
    # GIT TRUST (#53, add-scoped-prefix-git-trust): a writable root is
    # registered as a TREE ('<root>' + '<root>/*', git >= 2.46 prefix
    # semantics) so worktrees/repos created mid-session are trusted; a
    # read-only root keeps exact-match trust only, preserving git's
    # ownership refusal against hostile pre-existing nested .git/config in
    # unvetted content. TJOR_RO_DIRS also selects --allow-read (not
    # --allow-write) in the kernel wrap.
    [[ -n "${TJOR_WORKSPACE:-}" ]] && safe+=("${TJOR_WORKSPACE}")
    for dir in "${TJOR_EXTRA_DIRS[@]:-}"; do
        [[ -n "${dir}" ]] || continue
        verify_bind_source "${dir}"
        mounts+=(--volume "${dir}:${dir}")
        safe+=("${dir}")
        echo "tjor: + repo mount ${dir}" >&2
    done
    # Read-only extras (#44): the container-level :ro IS the enforcement —
    # it binds the whole container (docker exec included) on every runtime;
    # the kernel tier merely AGREES (--allow-read, entrypoint step 6). Still
    # a repo mount in every other sense: git-trusted (safe list) and covered
    # by the launch-time mask discovery below.
    local ro_dirs=""
    for dir in "${TJOR_EXTRA_DIRS_RO[@]:-}"; do
        [[ -n "${dir}" ]] || continue
        verify_bind_source "${dir}"
        mounts+=(--volume "${dir}:${dir}:ro")
        safe+=("${dir}")
        ro_dirs+="${dir}"$'\n'
        echo "tjor: + repo mount ${dir} (read-only)" >&2
    done
    local safe_dirs=""
    for dir in "${safe[@]:-}"; do
        [[ -n "${dir}" ]] || continue
        [[ "${dir}" == *$'\n'* ]] && die "refusing a mount path containing a newline: ${dir}"
        # Degenerate roots (#53): '/', '*', or a path ending in '/*' (a dir
        # literally named '*') would make the git-trust registration itself
        # wildcard-interpretable — safe.directory '/*' is blanket trust of
        # every path, the bare '*' ADR 0008 forbids. Refuse at launch; the
        # entrypoint re-refuses for non-launcher starts.
        case "${dir}" in
            /|\*|*/\*) die "refusing mount root '${dir}': its git-trust registration would be wildcard-interpretable (blanket trust is never registered)" ;;
        esac
        safe_dirs+="${dir}"$'\n'
    done
    export TJOR_SAFE_DIRS="${safe_dirs}"
    # Kernel-sandbox tier (#9), dotenv masking (design 2b): Landlock cannot
    # deny a path INSIDE the granted workspace, so in-repo secrets are masked
    # here at the mount level — a read-only /dev/null bind over each dotenv
    # file present at launch (host path == container path for repo mounts).
    # Works on every runtime, even where Landlock is unavailable; a mount
    # target cannot be unlinked or replaced from inside the container.
    # Residual (documented): a dotenv file created mid-session is not masked.
    local mp deny_list entry prev mask_list empty_src
    declare -A masked=()
    local -A dirmasked=()
    # Directory masks ([landlock].mask_dirs, #43): extend the /dev/null-style
    # file masking to DIRECTORIES — a read-only EMPTY host dir bound over
    # each target makes it structurally empty in-cage on every runtime. This
    # is the structural close for the project-config execution surface
    # (.opencode/plugins auto-loads arbitrary code outside the harness
    # permission matcher). An entry is an absolute path (masked directly,
    # like deny_paths) or a bare directory name (discovered recursively in
    # every mounted tree); globs, relative paths, empty strings and newlines
    # abort. Applied FIRST, before the file masks below, so a file mask is
    # never queued inside an already-masked directory (Docker cannot create
    # a mountpoint inside a read-only empty mount — the launch would fail).
    # Independent of mask_dotenv (#48 class). Directory names discovered in
    # mounted repos are UNTRUSTED: announcements go through safeprint, the
    # same escape-injection discipline as the dotenv lines below. Residual
    # (documented): a directory created mid-session is not masked.
    mask_list="$(cfg landlock.mask_dirs --default '[]' | python3 -c '
import json, sys
for e in json.load(sys.stdin):
    if not isinstance(e, str) or not e or "\n" in e:
        raise SystemExit("landlock.mask_dirs entry invalid (empty or newline): %r" % e)
    if any(c in e for c in "*?["):
        raise SystemExit("landlock.mask_dirs does not take glob patterns: %r" % e)
    if not e.startswith("/") and "/" in e:
        raise SystemExit("landlock.mask_dirs entry must be an absolute path or a bare directory name: %r" % e)
    print(e)')" || die "invalid landlock.mask_dirs"
    if [[ -n "${mask_list}" ]]; then
        # The mask source: a fresh empty dir under the session state root
        # (already VM-shared — the CA, profile stage and denials log live
        # there). Recreated every launch; mounted :ro, so nothing in-cage
        # can put content into it.
        empty_src="${TJOR_SESSION_DIR}/mask-empty"
        rm -rf "${empty_src}"
        mkdir -p "${empty_src}"
        while IFS= read -r entry; do
            [[ -n "${entry}" ]] || continue
            if [[ "${entry}" == /* ]]; then
                if [[ -d "${entry}" ]]; then
                    if [[ -z "${masked[${entry}]:-}" ]]; then
                        masked["${entry}"]=1; dirmasked["${entry}"]=1
                        mounts+=(--volume "${empty_src}:${entry}:ro")
                        echo "tjor: + dir mask $(safeprint "${entry}")" >&2
                    fi
                else
                    warn "landlock.mask_dirs entry not maskable (no such directory at launch): $(safeprint "${entry}")"
                fi
            else
                for dir in "${safe[@]:-}"; do
                    [[ -n "${dir}" ]] || continue
                    while IFS= read -r -d '' mp; do
                        [[ -n "${masked[${mp}]:-}" ]] && continue
                        # A hit nested inside an already-masked dir is
                        # already structurally empty — and mounting into it
                        # would fail (read-only empty mountpoint).
                        for prev in "${!dirmasked[@]}"; do [[ "${mp}" == "${prev}"/* ]] && continue 2; done
                        masked["${mp}"]=1; dirmasked["${mp}"]=1
                        mounts+=(--volume "${empty_src}:${mp}:ro")
                        echo "tjor: + dir mask $(safeprint "${mp}")" >&2
                    done < <(find "${dir}" -name .git -prune -o -type d -name "${entry}" -print0 2>/dev/null)
                done
            fi
        done <<<"${mask_list}"
    fi
    if [[ "$(cfg landlock.mask_dotenv --default true)" != "false" ]]; then
        for dir in "${safe[@]:-}"; do
            [[ -n "${dir}" ]] || continue
            # NUL-delimited: a filename may contain anything but NUL. Skip
            # non-secret templates and .git internals.
            while IFS= read -r -d '' mp; do
                [[ -n "${masked[${mp}]:-}" ]] && continue
                # Inside a masked directory the file is already unreachable —
                # and a mount there would fail (read-only empty mountpoint).
                for prev in "${!dirmasked[@]}"; do [[ "${mp}" == "${prev}"/* ]] && continue 2; done
                masked["${mp}"]=1
                mounts+=(--volume "/dev/null:${mp}:ro")
                # The filename comes from the mounted (untrusted) repo: this
                # status line is what tells the operator a secret WAS masked,
                # so it must not be spoofable by escape bytes in the name.
                echo "tjor: + dotenv mask $(safeprint "${mp}")" >&2
            done < <(find "${dir}" -name .git -prune -o -type f \
                        \( -name '.env' -o -name '.env.*' \) \
                        ! -name '*.example' ! -name '*.sample' ! -name '*.template' \
                        -print0 2>/dev/null)
        done
    fi
    # Operator-configured extra mask paths ([landlock].deny_paths) — applied
    # INDEPENDENTLY of mask_dotenv (#48): the toggle above governs only the
    # automatic .env discovery; an explicitly configured deny path must never
    # be silently dropped by an unrelated setting (config may only extend the
    # deny set, never weaken it — spec: kernel-sandbox).
    deny_list="$(cfg landlock.deny_paths --default '[]' | python3 -c '
import json, sys
for p in json.load(sys.stdin):
    if "\n" in p:
        raise SystemExit("landlock.deny_paths entry contains a newline: %r" % p)
    print(p)')" || die "invalid landlock.deny_paths"
    while IFS= read -r mp; do
        [[ -n "${mp}" ]] || continue
        [[ -n "${masked[${mp}]:-}" ]] && continue
        # An explicit deny path inside a masked directory is already covered
        # by the stronger structural mask (and unmountable-into anyway).
        for prev in "${!dirmasked[@]}"; do [[ "${mp}" == "${prev}"/* ]] && continue 2; done
        if [[ -f "${mp}" ]]; then
            masked["${mp}"]=1
            mounts+=(--volume "/dev/null:${mp}:ro")
            echo "tjor: + dotenv mask $(safeprint "${mp}") (deny_paths)" >&2
        else
            warn "landlock.deny_paths entry not maskable (no such file at launch): $(safeprint "${mp}")"
        fi
    done <<<"${deny_list}"
    # Agent profile (#29): mount the credential-filtered staging dir read-only
    # and tell the entrypoint where to overlay it. Empty env when no profile.
    local profile_env=""
    if [[ -n "${TJOR_PROFILE_STAGE:-}" && -d "${TJOR_PROFILE_STAGE}" ]]; then
        mounts+=(--volume "${TJOR_PROFILE_STAGE}:/opt/tjor/profile:ro")
        profile_env="/opt/tjor/profile"
        echo "tjor: + agent profile overlay" >&2
    fi
    # LLM gateway (D4): point the harness at the gateway with a PLACEHOLDER key
    # (the proxy injects the real key toward the gateway). Passed via -e ONLY
    # when enabled, so a normal session's harness auth is untouched.
    local -a gw_env=()
    if [[ -n "${TJOR_GATEWAY_ENABLED:-}" ]]; then
        gw_env=(-e "OPENAI_BASE_URL=${TJOR_GATEWAY_OPENAI_BASE}"
                -e "ANTHROPIC_BASE_URL=${TJOR_GATEWAY_ANTHROPIC_BASE}"
                -e "OPENAI_API_KEY=${TJOR_GATEWAY_AGENT_KEY}"
                -e "ANTHROPIC_API_KEY=${TJOR_GATEWAY_AGENT_KEY}")
        echo "tjor: + harness base_url -> gateway (placeholder key; real key injected at the proxy)" >&2
    fi
    # PTY allocation (#51): compose run decides pseudo-TTY allocation from the
    # COMPOSE CLIENT's own fds, not from the service's tty: true — and the
    # command substitution capturing ${ctr} below makes the client's stdout a
    # pipe, so the agent container would be created WITHOUT a PTY even when
    # launched from a real terminal. A container's Tty is fixed at creation
    # (docker attach can never add one), and a harness starting on pipe-stdin
    # breaks: claude falls into --print batch mode and errors, opencode's TUI
    # hangs silently. Force allocation (-T=false — the shorthand of
    # --no-tty/--no-TTY, stable across compose versions) whenever our own
    # stdin is a terminal; compose refuses the force otherwise ("stdin is not
    # a terminal"), so a terminal-less launch proceeds PTY-less with a loud
    # warning instead.
    local -a ttyforce=()
    if [[ -t 0 ]]; then
        ttyforce=(-T=false)
    else
        warn "no terminal on stdin — the agent container gets no PTY; interactive harnesses (claude, opencode TUIs) will NOT work in this session (one-shot commands are unaffected)"
    fi
    ctr="$(compose run -d "${ttyforce[@]}" "${mounts[@]}" -e TJOR_SAFE_DIRS="${safe_dirs}" -e TJOR_RO_DIRS="${ro_dirs}" -e TJOR_PROFILE_DIR="${profile_env}" "${gw_env[@]}" agent "$@")" || die "failed to start the agent container"
    # Fail-closed on the PTY we asked for: if a future compose changes its
    # allocation semantics, abort loudly — never hand the harness a silent
    # pipe-stdin hang that LOOKS like a running session.
    if ((${#ttyforce[@]})) && [[ "$(docker inspect -f '{{.Config.Tty}}' "${ctr}" 2>/dev/null)" != "true" ]]; then
        docker rm -f "${ctr}" >/dev/null 2>&1 || true
        die "agent container was created without the requested PTY — interactive harnesses cannot work; aborting (compose ignored the TTY force flag?)"
    fi
    if [[ -n "${detach}" ]]; then
        echo "tjor: session ${TJOR_SESSION} started detached — attach with: tjor attach ${TJOR_SESSION}" >&2
        return 0
    fi
    running="$(docker inspect -f '{{.State.Running}}' "${ctr}" 2>/dev/null || echo false)"
    if [[ "${running}" == "true" ]]; then
        echo "tjor: attached — detach without stopping the agent: ctrl-p ctrl-q" >&2
        docker attach --sig-proxy=false "${ctr}" || true
    fi
    code="$(docker inspect -f '{{.State.ExitCode}}' "${ctr}" 2>/dev/null || echo 0)"
    exit "${code:-0}"
}

# Gracefully stop a session's proxy so mitmdump runs its done() hook (which
# revokes the brokered credential). docker rm -f sends SIGKILL with no grace,
# so the proxy MUST be stopped with SIGTERM first, before anything force-
# removes it — otherwise revoke-on-teardown never fires (external review).
graceful_proxy_stop() { # $1 = session id
    local pc
    pc="$(docker ps -q --filter "label=tjor.session=$1" --filter "label=tjor.role=proxy" | head -1)"
    [[ -n "${pc}" ]] || return 0
    docker stop -t 12 "${pc}" >/dev/null 2>&1 || true
}

cmd_down() {
    local name=""
    [[ "${1:-}" == "--session" ]] && name="$2"
    resolve_session "opencode" "" "${name}"   # teardown: no broker mint
    # Report a no-op teardown (#52): tearing down a session that never existed
    # (e.g. a mistyped or mis-qualified name) used to look exactly like
    # success, hiding that the REAL session was left running. Docker resources
    # or real state count as traces; the empty home/ skeleton resolve_session
    # just created does not.
    if ! docker ps -aq --filter "label=tjor.session=${TJOR_SESSION}" | grep -q . \
       && ! docker network inspect "${TJOR_PROJECT}_internal" >/dev/null 2>&1 \
       && [[ -z "$(find "${TJOR_SESSION_DIR}" -mindepth 1 ! -name home -print -quit 2>/dev/null)" ]]; then
        warn "nothing found for session ${TJOR_SESSION} (no containers, networks, or state) — list sessions with: tjor ls"
    fi
    graceful_proxy_stop "${TJOR_SESSION}"
    # Persistent agent (compose run -d) containers aren't reliably caught by
    # `down --remove-orphans`; remove this session's by label explicitly.
    docker ps -aq --filter "label=tjor.session=${TJOR_SESSION}" | xargs -r docker rm -f >/dev/null 2>&1 || true
    compose down --volumes --remove-orphans
    docker network rm "${TJOR_PROJECT}_internal" >/dev/null 2>&1 || true
    echo "tjor: session topology ${TJOR_PROJECT} removed (state in ${TJOR_SESSION_DIR} preserved)" >&2
    # Denial recap (#42): teardown is the moment a quietly-blocked session is
    # most likely to be noticed — surface the session's denied egress
    # unprompted (count + top hosts + the review/widen hints), quiet when
    # there were none. Hostnames are attacker-influenced: aggregate in python
    # and render each through the shared terminal-escape sanitizer.
    if [[ -s "${TJOR_SESSION_DIR}/denials.log" ]]; then
        python3 - "${TJOR_SESSION_DIR}/denials.log" "${TJOR_ROOT}/python" <<'PY' >&2 || true
import collections
import sys

sys.path.insert(0, sys.argv[2])
from tjor_safeprint import sanitize

hosts = collections.Counter()
with open(sys.argv[1], "rb") as fh:
    for raw in fh.read().decode("utf-8", "surrogateescape").splitlines():
        parts = raw.split("\t")
        if len(parts) < 2:
            continue  # the cap notice, or a malformed line
        hosts[parts[0]] += 1
total = sum(hosts.values())
if total:
    top = ", ".join(f"{sanitize(h)} ({n})" for h, n in hosts.most_common(5))
    print(f"tjor: this session had {total} denied egress attempt(s) across {len(hosts)} host(s) — top: {top}")
    print("tjor: review with 'tjor denials'; allow what you need with: tjor policy add <host>")
PY
    fi
    # Workload-log read-volume recap (#50): teardown surfaces how much pods/log
    # content the session pulled in — the observability signal the exfiltration-
    # conscious profile checklist leans on. Observation only; quiet when none was
    # read. Pod identifiers are agent-influenced -> render via the same sanitizer.
    if [[ -s "${TJOR_SESSION_DIR}/logvolume.log" ]]; then
        python3 - "${TJOR_SESSION_DIR}/logvolume.log" <<'PY' >&2 || true
import sys

# Only aggregate counts are shown (no pod identifiers), so nothing
# agent-influenced reaches the terminal — no sanitizer needed here.
pods = set()
total = 0
with open(sys.argv[1], "rb") as fh:
    for raw in fh.read().decode("utf-8", "surrogateescape").splitlines():
        parts = raw.split("\t")
        if len(parts) != 2:
            continue  # the cap notice, or a malformed line
        try:
            total += int(parts[1])
        except ValueError:
            continue
        pods.add(parts[0])


def human(n):
    unit = "B"
    val = float(n)
    for u in ("KB", "MB", "GB", "TB", "PB"):
        if val < 1024:
            break
        val /= 1024
        unit = u
    return f"{val:.1f} {unit}" if unit != "B" else f"{int(val)} B"


if pods and total:
    print(f"tjor: this session read {human(total)} of workload logs across "
          f"{len(pods)} pod(s) — review what left the session with 'tjor denials'")
PY
    fi
    # Egress secret-tripwire recap (#62): best-effort, observe-only. If the proxy
    # saw known secret shapes in outbound inference bodies, surface a count + the
    # kinds (never the value). Honest: it's a tripwire for ACCIDENTAL leaks, not a
    # guarantee — content in the model context reaches allowed egress by design.
    if [[ -s "${TJOR_SESSION_DIR}/secretscan.log" ]]; then
        python3 - "${TJOR_SESSION_DIR}/secretscan.log" "${TJOR_ROOT}/python" <<'PY' >&2 || true
import sys

sys.path.insert(0, sys.argv[2])
from tjor_safeprint import sanitize

kinds = set()
n = 0
with open(sys.argv[1], "rb") as fh:
    for raw in fh.read().decode("utf-8", "surrogateescape").splitlines():
        parts = raw.split("\t")
        if len(parts) != 2:
            continue  # the cap notice, or a malformed line
        n += 1
        kinds.update(k for k in parts[1].split(",") if k)
if n:
    ks = ", ".join(sanitize(k) for k in sorted(kinds))
    print(f"tjor: {n} outbound inference request(s) contained what looked like a "
          f"discovered secret (kinds: {ks}) — best-effort tripwire, NOT a guarantee; "
          f"content in the model context reaches allowed egress by design")
PY
    fi
}

cmd_status() {
    local name=""
    [[ "${1:-}" == "--session" ]] && name="$2"
    resolve_session "opencode" "" "${name}"   # read-only: no broker mint
    compose ps
}

# ---------------------------------------------------------------- lifecycle

humanize_age() { # seconds -> compact age
    local s=$1
    if ((s < 3600)); then echo "$((s / 60))m"
    elif ((s < 86400)); then echo "$((s / 3600))h"
    else echo "$((s / 86400))d"; fi
}

iso_to_epoch() {
    python3 -c '
import sys, datetime
s = sys.argv[1].split(".")[0].removesuffix("Z")
try:
    print(int(datetime.datetime.fromisoformat(s + "+00:00").timestamp()))
except Exception:
    print(0)' "$1" 2>/dev/null || echo 0
}

cmd_ls() {
    # Discovery is label-driven; container names are never parsed.
    local now
    now="$(date +%s)"
    declare -A total agents_running any_running ws task launched
    # Field-separate on US (\x1f), not '|': a workspace path can contain a
    # literal pipe, which would misparse and mislabel a running session.
    while IFS=$'\x1f' read -r state sid wsp tsk lat role; do
        [[ -n "${sid}" ]] || continue
        total[${sid}]=$((${total[${sid}]:-0} + 1))
        [[ "${state}" == "running" && "${role}" == "agent" ]] && agents_running[${sid}]=$((${agents_running[${sid}]:-0} + 1))
        [[ "${state}" == "running" ]] && any_running[${sid}]=1
        [[ -n "${wsp}" ]] && ws[${sid}]="${wsp}"
        [[ -n "${tsk}" ]] && task[${sid}]="${tsk}"
        [[ -n "${lat}" ]] && launched[${sid}]="${lat}"
    done < <(docker ps -a --filter label=tjor.session \
        --format $'{{.State}}\x1f{{.Label "tjor.session"}}\x1f{{.Label "tjor.workspace"}}\x1f{{.Label "tjor.task"}}\x1f{{.Label "tjor.launched-at"}}\x1f{{.Label "tjor.role"}}')
    if ((${#total[@]} == 0)); then
        echo "tjor: no sessions" >&2
        return 0
    fi
    printf '%-40s %-9s %-7s %-6s %-40s %s\n' SESSION STATE AGENTS AGE WORKSPACE TASK
    local sid state age
    {
        for sid in "${!total[@]}"; do
            if ((${agents_running[${sid}]:-0} > 0)); then state="RUNNING"
            elif [[ -n "${any_running[${sid}]:-}" ]]; then state="IDLE"
            else state="EXITED"; fi
            # Re-verify the core guarantee for anything still running: the
            # launch-time check gets a repeatable checkpoint here.
            if [[ -n "${any_running[${sid}]:-}" ]] \
               && [[ "$(docker network inspect -f '{{.Internal}}' "tjor-${sid}_internal" 2>/dev/null)" != "true" ]]; then
                state="DEGRADED"
                loud "session ${sid} is DEGRADED: its agent network is NOT internal-only — treat the boundary as broken (tjor down / gc)"
            fi
            age="-"
            [[ -n "${launched[${sid}]:-}" ]] && age="$(humanize_age $((now - launched[${sid}])))"
            printf '%-40s %-9s %-7s %-6s %-40s %s\n' "${sid}" "${state}" \
                "${agents_running[${sid}]:-0}/${total[${sid}]}" "${age}" "${ws[${sid}]:--}" "${task[${sid}]:--}"
        done
    } | sort
}

cmd_attach() {
    local want="${1:-}" chosen ctr qualified=""
    local -a rows=()
    # Short names welcome (#52): a positional session argument matches either
    # the full session id (workspace-independent, as before) or the short name
    # qualified against the CURRENT workspace — so the name a user launched
    # with (`tjor run --session foo`) reattaches with `tjor attach foo`.
    if [[ -n "${want}" ]]; then
        qualified="$(session_base_id "$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)")-$(tr '[:upper:]' '[:lower:]' <<<"${want}")"
    fi
    # Field-separate on US (\x1f), not '|' — a workspace path can contain a
    # literal pipe (consistent with ls/gc).
    mapfile -t rows < <(docker ps --filter label=tjor.role=agent --filter status=running \
        --format $'{{.ID}}\x1f{{.Label "tjor.session"}}\x1f{{.Label "tjor.workspace"}}\x1f{{.Label "tjor.task"}}' \
        | { if [[ -n "${want}" ]]; then awk -F$'\x1f' -v s="${want}" -v q="${qualified}" '$2 == s || $2 == q'; else cat; fi; })
    ((${#rows[@]} > 0)) || die "no running agent${want:+ for session ${want}} — see: tjor ls"
    if ((${#rows[@]} == 1)); then
        chosen="${rows[0]}"
    elif command -v fzf >/dev/null 2>&1; then
        chosen="$(printf '%s\n' "${rows[@]}" | fzf --delimiter=$'\x1f' --with-nth=2.. --prompt='tjor attach> ')" \
            || die "nothing selected"
    else
        echo "tjor: several running agents:" >&2
        local i=1 row
        for row in "${rows[@]}"; do echo "  ${i}) $(cut -d$'\x1f' -f2,3 <<<"${row}")" >&2; ((i += 1)); done
        read -rp "attach to [1-${#rows[@]}]: " i
        if ! [[ "${i}" =~ ^[0-9]+$ ]] || ((i < 1 || i > ${#rows[@]})); then die "invalid selection"; fi
        chosen="${rows[$((i - 1))]}"
    fi
    ctr="$(cut -d$'\x1f' -f1 <<<"${chosen}")"
    # Testability seam: attach's logic is candidate RESOLUTION (above); the
    # exec below is a thin, trusted docker shell-out that cannot be driven
    # deterministically without a real TTY. TJOR_ATTACH_DRY reports the
    # resolved target instead of exec'ing, so tests verify the logic.
    if [[ -n "${TJOR_ATTACH_DRY:-}" ]]; then
        echo "$(cut -d$'\x1f' -f2 <<<"${chosen}") ${ctr}"
        return 0
    fi
    echo "tjor: attaching to $(cut -d$'\x1f' -f2 <<<"${chosen}") — detach without killing it: ctrl-p ctrl-q" >&2
    # --sig-proxy=false: interaction is through the PTY and detach is the
    # escape sequence, so the attach client's own signals (a stray SIGTERM,
    # timeout, a killed parent) must NOT be forwarded to tear down the agent.
    exec docker attach --sig-proxy=false "${ctr}"
}

cmd_gc() {
    local age_hours=24 dry="" now cutoff
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --age) age_hours="$2"; shift 2 ;;
            --dry-run) dry=1; shift ;;
            *) die "usage: tjor gc [--age <hours>] [--dry-run]" ;;
        esac
    done
    now="$(date +%s)"
    cutoff=$((now - age_hours * 3600))
    # gc deletes DOCKER RESOURCES ONLY, selected by tjor labels. Session
    # state dirs (auth!) are never touched here — that is `tjor reset`,
    # explicit and tiered. Last activity = newest agent FinishedAt, falling
    # back to launch time for sidecar-only sessions.
    declare -A has_running last_activity
    local id sid state role lat t
    while IFS=$'\x1f' read -r id sid state role lat; do
        [[ -n "${sid}" ]] || continue
        [[ "${state}" == "running" && "${role}" == "agent" ]] && has_running[${sid}]=1
        t=0
        if [[ "${role}" == "agent" && "${state}" != "running" ]]; then
            t="$(iso_to_epoch "$(docker inspect -f '{{.State.FinishedAt}}' "${id}" 2>/dev/null || true)")"
        fi
        [[ "${t}" == 0 && -n "${lat}" ]] && t="${lat}"
        ((t > ${last_activity[${sid}]:-0})) && last_activity[${sid}]="${t}"
    done < <(docker ps -a --filter label=tjor.session \
        --format $'{{.ID}}\x1f{{.Label "tjor.session"}}\x1f{{.State}}\x1f{{.Label "tjor.role"}}\x1f{{.Label "tjor.launched-at"}}')

    local reaped=0
    for sid in "${!last_activity[@]}"; do
        [[ -n "${has_running[${sid}]:-}" ]] && continue
        ((${last_activity[${sid}]:-0} <= cutoff)) || continue
        if [[ -n "${dry}" ]]; then
            echo "tjor gc: would tear down session ${sid} (idle $(humanize_age $((now - last_activity[${sid}])))): containers, networks, volumes — state dir untouched"
        else
            echo "tjor gc: tearing down idle session ${sid}" >&2
            # Stop the proxy gracefully first so its done() hook revokes the
            # session's brokered credential (D2) before force-removal (which
            # would SIGKILL it and skip revocation).
            graceful_proxy_stop "${sid}"
            docker ps -aq --filter "label=tjor.session=${sid}" | xargs -r docker rm -f >/dev/null 2>&1 || true
            "${COMPOSE[@]}" -p "tjor-${sid}" down --volumes --remove-orphans >/dev/null 2>&1 || true
            docker network rm "tjor-${sid}_internal" >/dev/null 2>&1 || true
        fi
        ((reaped += 1))
    done

    # Orphaned tjor-labeled networks whose session has no containers at all.
    local net netsid
    while read -r net; do
        netsid="$(docker network inspect -f '{{index .Labels "tjor.session"}}' "${net}" 2>/dev/null || true)"
        [[ -n "${netsid}" && -z "${has_running[${netsid}]:-}" && -z "${last_activity[${netsid}]:-}" ]] || continue
        if [[ -n "${dry}" ]]; then
            echo "tjor gc: would remove orphaned network ${net}"
        else
            docker network rm "${net}" >/dev/null 2>&1 || true
        fi
        ((reaped += 1))
    done < <(docker network ls --filter label=tjor.session --format '{{.Name}}')

    ((reaped > 0)) || echo "tjor gc: nothing to reap" >&2
}

cmd_reset() {
    local name="" dry="" tier="" force_reset=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --session) name="$2"; shift 2 ;;
            --dry-run) dry=1; shift ;;
            --force) force_reset=1; shift ;;
            cache|sessions|creds|all) tier="$1"; shift ;;
            *) die "usage: tjor reset {cache|sessions|creds|all} [--session <name>] [--dry-run] [--force]" ;;
        esac
    done
    [[ -n "${tier}" ]] || die "tjor reset requires an explicit tier: cache | sessions | creds | all"
    resolve_session "opencode" "" "${name}"   # state teardown: no broker mint
    # TOCTOU guard: the ancestors check and the rm are two syscalls. With the
    # persistent-container model a LIVE agent (write access to the same home
    # tree) could swap a dir for a symlink between them. Refuse to reset a
    # running session — `tjor down` first — unless --force is given (a live
    # race is then the caller's accepted risk). This removes the racer.
    if [[ -z "${dry}" && -z "${force_reset}" ]] \
       && docker ps -q --filter "label=tjor.role=agent" --filter "label=tjor.session=${TJOR_SESSION}" --filter status=running | grep -q .; then
        die "session ${TJOR_SESSION} has a running agent — 'tjor down' first, or pass --force (accepts a live-swap race)"
    fi
    local -a paths=()
    case "${tier}" in
        cache) paths=("${TJOR_SESSION_DIR}/home/.cache") ;;
        sessions) paths=(
            "${TJOR_SESSION_DIR}/home/.local/state"
            "${TJOR_SESSION_DIR}/home/.local/share/opencode/storage"
            "${TJOR_SESSION_DIR}/home/.local/share/opencode/log"
        ) ;;
        creds) paths=(
            "${TJOR_SESSION_DIR}/broker"
            "${TJOR_SESSION_DIR}/proxy-ca"
            "${TJOR_SESSION_DIR}/ca.pem"
            "${TJOR_SESSION_DIR}/home/.local/share/opencode/auth.json"
            "${TJOR_SESSION_DIR}/home/.config/gh"
        ) ;;
        all) paths=("${TJOR_SESSION_DIR}") ;;
    esac
    local p found=""
    for p in "${paths[@]}"; do
        [[ -e "${p}" || -L "${p}" ]] || continue
        # charter L26: rm removes a *leaf* symlink safely, but it FOLLOWS a
        # symlink anywhere in the path PREFIX — so an agent that swaps an
        # intermediate dir (e.g. home/.local/share/opencode) for a symlink
        # could redirect the wipe outside the session. Refuse unless every
        # ancestor of the target is a real directory under the session root.
        if ! ancestors_are_real_dirs "${TJOR_SESSION_DIR}" "${p}"; then
            loud "reset: REFUSING ${p} — a symlink in its path could redirect deletion outside the session (charter L26)"
            continue
        fi
        found=1
        if [[ -n "${dry}" ]]; then
            echo "tjor reset: would delete ${p}"
        else
            rm -rf "${p}"
            echo "tjor reset: deleted ${p}" >&2
        fi
    done
    [[ -n "${found}" ]] || echo "tjor reset: nothing to delete for tier '${tier}'" >&2
}

# Every ancestor of <target>, from <root> down to target's parent, must be a
# real directory (not a symlink, not a non-dir). The leaf itself may be a
# symlink — rm removes the link, not its target. Returns non-zero on any
# violation, including target not being under root.
ancestors_are_real_dirs() { # $1 root, $2 target
    local root="$1" target="$2" parent rel cur comp
    [[ "${target}" == "${root}/"* ]] || { [[ "${target}" == "${root}" ]] && return 0 || return 1; }
    parent="$(dirname "${target}")"
    [[ -L "${root}" ]] && return 1
    rel="${parent#"${root}"}"; rel="${rel#/}"
    cur="${root}"
    local IFS='/'
    for comp in ${rel}; do
        [[ -z "${comp}" ]] && continue
        cur="${cur}/${comp}"
        [[ -L "${cur}" ]] && return 1
        [[ -e "${cur}" && ! -d "${cur}" ]] && return 1
    done
    return 0
}

active_writable_policy() { # echoes a policy file safe to edit (never the packaged default)
    local active user
    active="$(policy_file)"
    user="${XDG_CONFIG_HOME:-$HOME/.config}/tjor/policy.toml"
    if [[ "${active}" == "${TJOR_ROOT}/config/policy.toml" ]]; then
        mkdir -p "$(dirname "${user}")"; cp "${active}" "${user}"
        echo "${user}"
    else
        echo "${active}"   # user policy, or a trusted repo policy
    fi
}

cmd_policy() {
    if [[ "${1:-}" == "add" ]]; then
        shift
        local pyes="" a
        local -a addhosts=()
        for a in "$@"; do
            case "${a}" in --yes|-y) pyes=1 ;; *) addhosts+=("${a}") ;; esac
        done
        [[ ${#addhosts[@]} -ge 1 ]] || die "usage: tjor policy add <host> [host...] [--yes]"
        local target; target="$(active_writable_policy)"
        # Adding to a TRUSTED repo policy re-approves it (its hash changes),
        # re-widening the boundary from a file that travels with the repo. Make
        # that explicit and confirm it — never a silent re-approve — so an
        # agent's suggested "tjor policy add ..." can't quietly re-bless a repo
        # file. Adding to the user policy stays quick (no re-approval involved).
        if [[ "${target}" == */.tjor/policy.toml ]]; then
            loud "this WIDENS and re-approves a trusted repo policy (${target}): ${addhosts[*]}"
            if [[ -z "${pyes}" ]]; then
                if [[ -r /dev/tty && -t 2 ]]; then
                    local reply=""
                    printf 'tjor: add these host(s) and re-approve the repo policy? [y/N] ' >&2
                    read -r reply </dev/tty || reply=""
                    [[ "${reply}" =~ ^[Yy]([Ee][Ss])?$ ]] || die "aborted (repo policy unchanged)"
                else
                    die "re-approving a repo policy needs confirmation — re-run with --yes"
                fi
            fi
        fi
        python3 "${TJOR_ROOT}/python/tjor_policy_edit.py" add "${target}" "${addhosts[@]}"
        [[ "${target}" == */.tjor/policy.toml ]] && python3 "${TJOR_ROOT}/python/tjor_trust.py" approve "${target}" >/dev/null
        echo "tjor: added to ${target}: ${addhosts[*]}" >&2
        return 0
    fi
    local explain=""
    local -a rest=()
    for a in "$@"; do [[ "${a}" == "--explain" ]] && explain=1 || rest+=("${a}"); done
    [[ ${#rest[@]} -ge 1 ]] || die "usage: tjor policy <url> [--explain]  |  tjor policy add <host>"
    local pf; pf="$(policy_file)"
    [[ -n "${explain}" ]] && echo "tjor: active policy: ${pf}" >&2
    python3 "${TJOR_ROOT}/python/tjor_policy.py" check --policy "${pf}" "${rest[0]}"
}

cmd_init() {
    local root; root="$(repo_root)"
    [[ -n "${root}" ]] || die "tjor init: run inside a git repository"
    local dir="${root}/.tjor"
    mkdir -p "${dir}"
    [[ -f "${dir}/policy.toml" ]] || cp "${TJOR_ROOT}/config/policy.toml" "${dir}/policy.toml"
    if [[ ! -f "${dir}/config.toml" ]]; then
        cat > "${dir}/config.toml" <<'EOF'
# Per-repo tjor config. Honored only after you approve it: `tjor trust`.
# Layers over your user config for sessions in this repo. Example:
# [identity]
# inject_hosts = ["api.anthropic.com"]
EOF
    fi
    echo "tjor: scaffolded ${dir}/ (policy.toml, config.toml)" >&2
    echo "tjor: review, then approve with: tjor trust   (present but UNTRUSTED until then)" >&2
}

cmd_trust() {
    local root; root="$(repo_root)"
    [[ -n "${root}" ]] || die "tjor trust: run inside a git repository"
    local -a files=("${root}/.tjor/policy.toml" "${root}/.tjor/config.toml")
    local show="" yes="" arg
    for arg in "$@"; do
        case "${arg}" in
            --show) show=1 ;;
            --yes|-y) yes=1 ;;
            *) die "usage: tjor trust [--show] [--yes]" ;;
        esac
    done
    local any="" f
    for f in "${files[@]}"; do
        [[ -f "${f}" ]] || continue
        any=1
        echo "=== ${f}" >&2
        # Render untrusted file content through the terminal-escape sanitizer.
        # A hostile .tjor file (planted by a repo contributor, or written by a
        # compromised agent before review) could embed ANSI/OSC/bidi sequences
        # to HIDE or SPOOF lines — so the operator would approve bytes other
        # than what they saw, and the content hash then pins exactly those
        # misrepresented bytes. Never print the raw file to the terminal.
        python3 "${TJOR_ROOT}/python/tjor_safeprint.py" "${f}" | sed 's/^/    /' >&2
    done
    [[ -n "${any}" ]] || die "no .tjor/config.toml or .tjor/policy.toml here — scaffold with: tjor init"
    # --show reviews only, never approves.
    if [[ -n "${show}" ]]; then return 0; fi
    # Genuine two-step gate: approval is a SEPARATE act from display, taken only
    # after the operator has seen the (sanitized) content. --yes approves
    # non-interactively (e.g. automation that already reviewed with --show).
    if [[ -z "${yes}" ]]; then
        if [[ -r /dev/tty && -t 2 ]]; then
            local reply=""
            printf 'tjor: approve the content shown above as trusted? [y/N] ' >&2
            read -r reply </dev/tty || reply=""
            [[ "${reply}" =~ ^[Yy]([Ee][Ss])?$ ]] || die "trust not granted (no approval given)"
        else
            die "tjor trust needs confirmation — re-run with --yes to approve non-interactively (review first: tjor trust --show)"
        fi
    fi
    for f in "${files[@]}"; do
        [[ -f "${f}" ]] && python3 "${TJOR_ROOT}/python/tjor_trust.py" approve "${f}" >/dev/null
    done
    echo "tjor: approved this repo's .tjor config — honored on the next launch (re-run after any edit)" >&2
}

cmd_denials() {
    local name="" root sid dir
    [[ "${1:-}" == "--session" ]] && name="$2"
    resolve_session "opencode" "" "${name}"   # read-only: no broker mint (diagnostics stay visible)
    dir="${TJOR_SESSION_DIR}"
    if [[ -s "${dir}/denials.log" ]]; then
        echo "tjor: denied egress for session ${TJOR_SESSION} (host  rule  time):" >&2
        # The host column is attacker-influenced (the destination the agent
        # tried to reach). Render it through the terminal-escape sanitizer so a
        # hostile hostname can't inject ANSI/OSC sequences into this display.
        python3 "${TJOR_ROOT}/python/tjor_safeprint.py" "${dir}/denials.log"
        echo "tjor: add any you need with: tjor policy add <host>" >&2
    else
        echo "tjor: no denied egress recorded for session ${TJOR_SESSION}" >&2
    fi
}

cmd_gateway() {
    case "${1:-}" in
        rotate-key)
            # Regenerate the per-install gateway master key. Running gateway
            # sessions keep the key they started with (the proxy + gateway hold
            # it) until relaunched; new sessions pick up the new key.
            python3 "${TJOR_ROOT}/python/tjor_gateway.py" rotate-key >/dev/null \
                || die "gateway: key rotation failed"
            echo "tjor: gateway master key rotated — new sessions use the new key; running gateway sessions keep the old key until relaunched." >&2
            ;;
        ""|-h|--help) echo "usage: tjor gateway rotate-key" >&2 ;;
        *) die "unknown 'gateway' subcommand: $1 (try: rotate-key)" ;;
    esac
}

cmd_conformance() {
    export TJOR_POLICY_OVERRIDE="${TJOR_ROOT}/images/conformance/policy.toml"
    export TJOR_SESSION="conformance"
    export TJOR_SESSION_ID="conformance"
    export TJOR_HARNESS="conformance"
    export TJOR_REPO="conformance"
    export TJOR_TASK_ID="" TJOR_WORKTREE="" TJOR_PARENT_SESSION=""
    export TJOR_INJECT_HOSTS="echo-inject.tjor-test"
    TJOR_LAUNCHED_AT="$(date +%s)"
    export TJOR_LAUNCHED_AT
    export TJOR_PROJECT="tjor-conformance"
    # Session dir must live under $HOME: VM-based runtimes (Colima, Docker
    # Desktop) only share user paths, and an unshared bind source silently
    # becomes an empty directory inside the VM.
    mkdir -p "${HOME}/.tjor/tmp"
    TJOR_SESSION_DIR="$(mktemp -d "${HOME}/.tjor/tmp/conformance.XXXXXX")"
    export TJOR_SESSION_DIR
    export TJOR_WORKSPACE="${TJOR_SESSION_DIR}"
    export TJOR_LAUNCH_DIR="${TJOR_SESSION_DIR}"
    mkdir -p "${TJOR_SESSION_DIR}/home"
    export_static_env
    # Stub broker (D2): a pat source with a known token, injected toward the
    # echo-broker host only. The probe asserts the token reaches the echo
    # upstream but is ABSENT from the conformance container.
    TJOR_TEST_BROKER_TOKEN="tjor-stub-secret-$(printf %s "${TJOR_SESSION_DIR}" | sha256 | cut -c1-12)"
    export TJOR_TEST_BROKER_TOKEN
    local bdir="${TJOR_SESSION_DIR}/broker"
    mkdir -p "${bdir}"; chmod 700 "${bdir}"
    write_broker_json "${bdir}/broker.json" pat "${TJOR_TEST_BROKER_TOKEN}"
    export TJOR_BROKER_DIR="${bdir}" TJOR_BROKER_CONFIG_MOUNT="${bdir}/broker.json"
    export TJOR_BROKER_HOSTS="echo-broker.tjor-test" TJOR_BROKER_ENABLED=1
    # Clean up even when interrupted — an aborted run must not leak
    # containers, networks, or the temp session dir.
    trap 'compose down --volumes --remove-orphans >/dev/null 2>&1 || true;
          docker network rm "${TJOR_PROJECT}_internal" >/dev/null 2>&1 || true;
          rm -rf "${TJOR_SESSION_DIR}"' EXIT
    trap 'exit 130' INT TERM   # make Ctrl-C exit promptly; EXIT trap cleans up
    # The identity probes talk to an echo fixture on a container-network
    # (non-global) address; the rebind guard would rightly deny that, so it
    # is off HERE ONLY. The guard itself is covered by unit tests.
    export TJOR_IP_GUARD="off"
    build_conformance
    ensure_topology
    "${COMPOSE[@]}" -f "${TJOR_ROOT}/compose.yaml" up -d echo >/dev/null 2>&1
    local rc=0 out
    # Show the probe output live AND capture it, so the attestation can carry the
    # ACTUAL probe count from the suite's summary (never hardcoded — it grows
    # with every hardening increment). pipefail makes $? the run's status (tee
    # succeeds); the brace-group `|| rc=$?` keeps set -e from aborting first.
    out="$(mktemp "${HOME}/.tjor/tmp/conf-out.XXXXXX")"
    { "${COMPOSE[@]}" -f "${TJOR_ROOT}/compose.yaml" run --rm conformance 2>&1 | tee "${out}"; } || rc=$?
    local runtime probes result
    runtime="$(detect_runtime)"
    probes="$(sed -n 's/.*conformance: [0-9][0-9]*\/\([0-9][0-9]*\) probes passed.*/\1/p' "${out}" | tail -1)"
    [[ -n "${probes}" ]] || probes="?"
    rm -f "${out}"
    if ((rc == 0)); then
        result="PASS"
        echo "tjor: conformance PASSED — the boundary holds [runtime=${runtime}]" >&2
    else
        result="FAIL"
        loud "conformance FAILED (rc=${rc}) — the boundary does NOT hold [runtime=${runtime}]"
    fi
    # Copy-pasteable, checkable attestation for docs/conformance-matrix.md (#13):
    # paste this line into the matrix row for a runtime CI can't reach.
    echo "tjor: conformance-attestation: result=${result} runtime=${runtime} probes=${probes} date=$(date +%Y-%m-%d)" >&2
    return "${rc}"
}

cmd_doctor() {
    echo "tjor root:     ${TJOR_ROOT}"
    echo "policy file:   $(policy_file)"
    python3 "${TJOR_ROOT}/python/tjor_policy.py" validate --policy "$(policy_file)" || true
    report_tiers
    if [[ "${1:-}" == "--full" ]]; then cmd_conformance; fi
}

cmd_build() {
    local harness="opencode"
    [[ "${1:-}" == "--harness" ]] && harness="$2"
    build_proxy && echo "tjor: built tjor-proxy:local" >&2
    build_conformance && echo "tjor: built tjor-conformance:local" >&2
    build_agent "${harness}"
}

usage() {
    cat <<'EOF'
tjor — run AI coding agents inside a portable, fail-closed container cage

usage: tjor <command> [args]

  run [--harness opencode|claude|copilot] [--task <id>] [--session <name>] [--dir <path>]... [--dir-ro <path>]... [--unsafe-dir] [--profile <name>|--profile-dir <path>] [--detach] [cmd...]
                                                     launch a caged session (--dir: mount another repo at its host path; --dir-ro: same but READ-ONLY, container-wide — sensitive paths refused unless --unsafe-dir; --profile/--profile-dir: overlay host-defined agents/commands, credential-safe; --detach: start without attaching)
  ls                                                 list all sessions (and re-verify their boundaries)
  attach [session]                                   reattach to a running agent's terminal (short name or full id)
  gc [--age <hours>] [--dry-run]                     reap idle session containers/networks/volumes
  reset {cache|sessions|creds|all} [--session <name|id>] [--dry-run]
                                                     tiered wipe of this repo's session state
  down [--session <name|id>]                         tear down a session's topology (short name, or any session's full id)
  status [--session <name|id>]                       show a session's containers
  policy <url> [--explain]                           evaluate a URL against the active egress policy
  policy add <host>... [--yes]                       add host(s) to the active policy (re-approving a trusted repo policy is confirmed; --yes to skip)
  denials [--session <name>]                         show egress denied in a session (then: tjor policy add <host>)
  init                                               scaffold a per-repo .tjor/ (policy + config)
  trust [--show] [--yes]                             review this repo's .tjor config, then approve it (--show: review only; --yes: approve non-interactively)
  gateway rotate-key                                 regenerate the LLM gateway master key (D4; new sessions use it)
  conformance                                        run the adversarial conformance suite
  doctor [--full]                                    check host deps, policy, guarantees (--full: + conformance)
  build [--harness ...]                              (re)build the images
EOF
}

main() {
    local cmd="${1:-}"
    [[ -n "${cmd}" ]] || { usage; exit 1; }
    shift || true
    case "${cmd}" in help|-h|--help) usage; exit 0 ;; esac
    preflight
    case "${cmd}" in
        run) cmd_run "$@" ;;
        ls) cmd_ls "$@" ;;
        attach) cmd_attach "$@" ;;
        gc) cmd_gc "$@" ;;
        reset) cmd_reset "$@" ;;
        down) cmd_down "$@" ;;
        status) cmd_status "$@" ;;
        policy) cmd_policy "$@" ;;
        denials) cmd_denials "$@" ;;
        init) cmd_init "$@" ;;
        trust) cmd_trust "$@" ;;
        gateway) cmd_gateway "$@" ;;
        conformance) cmd_conformance "$@" ;;
        doctor) cmd_doctor "$@" ;;
        build) cmd_build "$@" ;;
        help|-h|--help) usage ;;
        *) usage; exit 1 ;;
    esac
}

# Source-guard: a test can `source` this file to unit-test its functions (e.g.
# the kube-broker mint/derive path with a mocked kubectl) without running the
# CLI. When executed normally, BASH_SOURCE[0] == $0 and main runs as before.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
